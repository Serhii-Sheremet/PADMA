<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PADMA.Pages.PaymentPage"
             Title="Support PADMA">

    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="close_icon.png"
                 Priority="0"
                 Order="Primary"
                 Clicked="OnCloseClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto">

        <!-- Scrollable content -->
        <ScrollView Grid.Row="0">

            <VerticalStackLayout Padding="20" Spacing="10">

                <!-- Description -->
                <Label x:Name="lblDesclabel"
                       HorizontalOptions="Fill"
                       HorizontalTextAlignment="Start"
                       FontSize="16"
                       Margin="10,10,0,0"/>

                <Label x:Name="lblSubDesclabel"
                       HorizontalOptions="Fill"
                       HorizontalTextAlignment="Start"
                       FontSize="16"
                       FontAttributes="Italic"
                       Margin="10,6,0,0"/>

                <Border Margin="0,10,0,0"
                        Stroke="#BDBDBD"
                        StrokeThickness="1"
                        Padding="10">

                    <VerticalStackLayout Spacing="6">

                        <Grid ColumnDefinitions="Auto,*"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="10">

                            <Image Source="paypal.png"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                   HeightRequest="50"
                                   Aspect="AspectFit"
                                   Opacity="0.85"
                                   Margin="0,6,0,0"/>

                            <Button x:Name="btnPayPalSupport"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="6,0,6,6"
                                    HeightRequest="34"
                                    FontAttributes="Bold"
                                    BackgroundColor="#2196F3"
                                    TextColor="White"
                                    CornerRadius="10"
                                    Clicked="OnPayPalSupportClicked" />

                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Margin="0,10,0,0"
                        Stroke="#BDBDBD"
                        StrokeThickness="1"
                        Padding="10">

                    <VerticalStackLayout Spacing="6">

                        <Grid ColumnDefinitions="Auto,*"
                               RowDefinitions="Auto,Auto"
                               ColumnSpacing="10">

                            <Image Source="kofi.png"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                   HeightRequest="50"
                                   Aspect="AspectFit"
                                   Opacity="0.85"
                                   Margin="0,6,0,0"/>

                            <Button x:Name="btnKoFiSupport"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="6,0,6,6"
                                    HeightRequest="34"
                                    FontAttributes="Bold"
                                    BackgroundColor="#2196F3"
                                    TextColor="White"
                                    CornerRadius="10"
                                    Clicked="OnKoFiSupportClicked" />

                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="10"/>
                
                <Label x:Name="lblQuoteLabel"
                       HorizontalOptions="Fill"
                       HorizontalTextAlignment="Center"
                       FontSize="16"
                       Margin="0,6,0,0"/>

            </VerticalStackLayout>
        </ScrollView>

        <!--  Busy overlay -->
        <Grid Grid.Row="0"
              Grid.ColumnSpan="2"
              IsVisible="{Binding IsBusy, FallbackValue=False}"
              InputTransparent="False"
              BackgroundColor="#80000000"
              ZIndex="999">

            <VerticalStackLayout
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="12">

                <ActivityIndicator
                    IsRunning="True"
                    WidthRequest="48"
                    HeightRequest="48" />

                <Label Text="{Binding BusyText}"
                       TextColor="White"
                       FontSize="Medium"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>