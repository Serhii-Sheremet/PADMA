<?xml version="1.0" encoding="utf-8" ?>
<ui:ConfigBasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ui="clr-namespace:PADMA.UI.Templates;assembly=PADMA"
    xmlns:charts="clr-namespace:PADMA.UI.Charts;assembly=PADMA"
    x:Class="PADMA.Pages.TransitChartsPage">

    <AbsoluteLayout>

        <!-- Main page content -->
        <Grid AbsoluteLayout.LayoutBounds="0,0,1,1"
              AbsoluteLayout.LayoutFlags="All"
              RowDefinitions="Auto,Auto,*"
              RowSpacing="8"
              Padding="10,0,10,10">

            <!-- Tabs -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="10"
                  Margin="0,0,0,4"
                  HorizontalOptions="Start">

                <!-- Current Transits -->
                <Grid Grid.Column="0"
                      RowDefinitions="Auto,4">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCurrentTransitsTapped" />
                    </Grid.GestureRecognizers>

                    <Label x:Name="CurrentTabLabel"
                           Grid.Row="0"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           LineBreakMode="NoWrap" />

                    <BoxView x:Name="CurrentTabIndicator"
                             Grid.Row="1"
                             HeightRequest="2"
                             Color="#C8A23A"
                             HorizontalOptions="Fill" />
                </Grid>

                <!-- Natal Transits -->
                <Grid Grid.Column="1"
                      RowDefinitions="Auto,4">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNatalTransitsTapped" />
                    </Grid.GestureRecognizers>

                    <Label x:Name="NatalTabLabel"
                           Grid.Row="0"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           LineBreakMode="NoWrap" />

                    <BoxView x:Name="NatalTabIndicator"
                             Grid.Row="1"
                             HeightRequest="2"
                             Color="#C8A23A"
                             HorizontalOptions="Fill" />
                </Grid>

                <!-- Natal reference header -->
                <VerticalStackLayout Grid.Column="2"
                                 Spacing="2"
                                 HorizontalOptions="Start"
                                 VerticalOptions="Center">
                    <HorizontalStackLayout x:Name="NatalReferenceHeader"
                                       Spacing="4"
                                       HorizontalOptions="Start">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNatalReferenceTapped" />
                        </HorizontalStackLayout.GestureRecognizers>

                        <Label x:Name="NatalReferenceLabel"
                               Margin="0,-1,0,0"
                               VerticalOptions="Center" />

                        <Label x:Name="NatalReferenceArrow"
                               Margin="0,-1,0,0"
                               Text="▼"
                               FontSize="14"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <BoxView x:Name="NatalReferenceUnderline"
                             Margin="0,-1,0,0"
                             HeightRequest="2"
                             Color="#C8A23A"
                             HorizontalOptions="Start" 
                             WidthRequest="40"/>
                    
                </VerticalStackLayout>
            </Grid>

            <!-- Fixed date/time header -->
            <Grid Grid.Row="1"
                  ColumnDefinitions="*,110"
                  ColumnSpacing="0"
                  HorizontalOptions="Fill"
                  Margin="0,0,0,2"
                  MaximumHeightRequest="42">

                <Border Grid.Column="0"
                        Stroke="#BDBDBD"
                        StrokeThickness="1"
                        BackgroundColor="Transparent"
                        Padding="6,0"
                        MinimumHeightRequest="40"
                        MaximumHeightRequest="40">
                    <DatePicker x:Name="transitDatePicker"
                                Format="D"
                                HeightRequest="38"
                                MinimumHeightRequest="38"
                                HorizontalOptions="CenterAndExpand"
                                VerticalOptions="Center"
                                Date="{Binding CurrentTransitLocalDateTime, Mode=OneWay}"
                                DateSelected="OnTransitDateSelected" />
                </Border>

                <Border Grid.Column="1"
                        Stroke="#BDBDBD"
                        StrokeThickness="1"
                        BackgroundColor="Transparent"
                        Padding="6,0"
                        Margin="-1,0,0,0"
                        MinimumHeightRequest="40"
                        MaximumHeightRequest="40">
                    <TimePicker x:Name="transitTimePicker"
                                Format="HH:mm:ss"
                                HeightRequest="38"
                                MinimumHeightRequest="38"
                                HorizontalOptions="CenterAndExpand"
                                VerticalOptions="Center"
                                Time="{Binding CurrentTransitLocalDateTime, Converter={StaticResource DateTimeToTimeSpanConverter}, Mode=OneWay}"
                                PropertyChanged="OnTransitTimeChanged" />
                </Border>
            </Grid>

            <!-- Scrollable content -->
            <ScrollView Grid.Row="2">
                <VerticalStackLayout Spacing="2">

                    <charts:NorthIndianChartView
                                x:Name="ChartView"
                                HorizontalOptions="Fill"
                                ChartBackgroundColor="#FAFAD2"
                                ChartLineColor="Black"
                                ChartLineStrokeWidth="1" />

                    <Grid RowDefinitions="Auto,*"
                          ColumnSpacing="8"
                          RowSpacing="4"
                          VerticalOptions="Center"
                          Margin="0,2,0,0"
                          MinimumHeightRequest="32">

                        <!-- Aspects header -->
                        <HorizontalStackLayout Grid.Row="0"
                            x:Name="AspectsHeaderLayout"
                            Spacing="6"
                            HorizontalOptions="Start"
                            VerticalOptions="Center">
                            
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAspectsHeaderTapped" />
                            </HorizontalStackLayout.GestureRecognizers>

                            <VerticalStackLayout Spacing="2"
                                    HorizontalOptions="Start">
                                <HorizontalStackLayout Spacing="4"
                                       HorizontalOptions="Start">
                                    <Label x:Name="AspectsLabel"
                                       FontSize="16"
                                       VerticalOptions="Center" />

                                    <Label x:Name="AspectsExpandIcon"
                                       FontSize="14"
                                       VerticalOptions="Center"
                                       Text="▼" />
                                </HorizontalStackLayout>

                                <BoxView x:Name="AspectsUnderline"
                                     HeightRequest="2"
                                     WidthRequest="40"
                                     Color="#C8A23A"
                                     HorizontalOptions="Start" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <!-- shift control -->
                        <Grid Grid.Column="1"
                              ColumnDefinitions="Auto,Auto,Auto,Auto"
                              ColumnSpacing="6"
                              HorizontalOptions="End"
                              VerticalOptions="Center">

                            <ImageButton Grid.Column="0"
                                    Source="left_arrow.png"
                                    BackgroundColor="Transparent"
                                    WidthRequest="16"
                                    HeightRequest="16"
                                    Padding="0"
                                    Margin="0"
                                    Clicked="OnStepBackClicked" />
                            
                            <HorizontalStackLayout Grid.Column="1"
                                    x:Name="StepUnitHeader"
                                    Spacing="4"
                                    VerticalOptions="Center">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnStepUnitTapped" />
                                </HorizontalStackLayout.GestureRecognizers>

                                <VerticalStackLayout Spacing="2"
                                        HorizontalOptions="Start">
                                    <HorizontalStackLayout Spacing="4"
                                            HorizontalOptions="Start">
                                        <Label x:Name="StepUnitLabel"
                                           VerticalOptions="Center"
                                           Text="{Binding SelectedStepUnit}" />

                                        <Label x:Name="StepUnitArrow"
                                               Text="▼"
                                               FontSize="14"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <BoxView x:Name="StepUnitline"
                                             HeightRequest="2"
                                             WidthRequest="40"
                                             Color="#C8A23A"
                                             HorizontalOptions="Start" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>

                            <Entry Grid.Column="2"
                                   x:Name="StepValueEntry"
                                   WidthRequest="10"
                                   HeightRequest="20"
                                   FontSize="12"
                                   Margin="0,-5,0,0"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   Keyboard="Numeric"
                                   Text="{Binding SelectedStepValue}" />

                            <ImageButton Grid.Column="3"
                                    Source="right_arrow.png"
                                    BackgroundColor="Transparent"
                                    WidthRequest="16"
                                    HeightRequest="16"
                                    Padding="0"
                                    Margin="0" 
                                    Clicked="OnStepForwardClicked" />
                        </Grid>

                        <!-- Expandable panel -->
                        <Border Grid.Row="1"
                                x:Name="AspectsPanel"
                                IsVisible="False"
                                Stroke="#D0D0D0"
                                StrokeThickness="1"
                                Padding="8,6"
                                BackgroundColor="Transparent"
                                HorizontalOptions="Fill">

                            <Grid ColumnDefinitions="*,*,*"
                                  RowDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="12"
                                  RowSpacing="4">

                                <!-- Row 1 -->
                                <Grid Grid.Row="0" Grid.Column="0"
                                      ColumnDefinitions="22,*"
                                      HeightRequest="26">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAspectAllTapped" />
                                    </Grid.GestureRecognizers>
                                    <Border x:Name="AspectAllBox"
                                            Grid.Column="0"
                                            WidthRequest="18"
                                            HeightRequest="18"
                                            Stroke="#5A46FF"
                                            StrokeThickness="2"
                                            BackgroundColor="Transparent"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center">
                                        <Label x:Name="AspectAllCheck"
                                               Text="✓"
                                               IsVisible="False"
                                               FontSize="11"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                    <Label x:Name="LabelAspectAll"
                                           Grid.Column="1"
                                           FontSize="14"
                                           LineBreakMode="NoWrap"
                                           VerticalOptions="Center" />
                                </Grid>

                                <Grid Grid.Row="0" Grid.Column="1"
                                      ColumnDefinitions="22,*"
                                      HeightRequest="26">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAspectSunTapped" />
                                    </Grid.GestureRecognizers>
                                    <Border x:Name="AspectSunBox"
                                            Grid.Column="0"
                                            WidthRequest="18"
                                            HeightRequest="18"
                                            Stroke="#5A46FF"
                                            StrokeThickness="2"
                                            BackgroundColor="Transparent"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center">
                                        <Label x:Name="AspectSunCheck"
                                               Text="✓"
                                               IsVisible="False"
                                               FontSize="11"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                    <Label x:Name="LabelAspectSun"
                                           Grid.Column="1"
                                           FontSize="14"
                                           LineBreakMode="NoWrap"
                                           VerticalOptions="Center" />
                                </Grid>

                                <Grid Grid.Row="0" Grid.Column="2"
                                      ColumnDefinitions="22,*"
                                      HeightRequest="26">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAspectMoonTapped" />
                                    </Grid.GestureRecognizers>
                                    <Border x:Name="AspectMoonBox"
                                            Grid.Column="0"
                                            WidthRequest="18"
                                            HeightRequest="18"
                                            Stroke="#5A46FF"
                                            StrokeThickness="2"
                                            BackgroundColor="Transparent"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center">
                                        <Label x:Name="AspectMoonCheck"
                                               Text="✓"
                                               IsVisible="False"
                                               FontSize="11"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                    <Label x:Name="LabelAspectMoon"
                                           Grid.Column="1"
                                           FontSize="14"
                                           LineBreakMode="NoWrap"
                                           VerticalOptions="Center" />
                                </Grid>

                                <!-- Row 2 -->
                                <Grid Grid.Row="1" Grid.Column="0"
                                      ColumnDefinitions="22,*"
                                      HeightRequest="26">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAspectMarsTapped" />
                                    </Grid.GestureRecognizers>
                                    <Border x:Name="AspectMarsBox"
                                            Grid.Column="0"
                                            WidthRequest="18"
                                            HeightRequest="18"
                                            Stroke="#5A46FF"
                                            StrokeThickness="2"
                                            BackgroundColor="Transparent"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center">
                                        <Label x:Name="AspectMarsCheck"
                                               Text="✓"
                                               IsVisible="False"
                                               FontSize="11"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                    <Label x:Name="LabelAspectMars"
                                           Grid.Column="1"
                                           FontSize="14"
                                           LineBreakMode="NoWrap"
                                           VerticalOptions="Center" />
                                </Grid>

                                <Grid Grid.Row="1" Grid.Column="1"
                                      ColumnDefinitions="22,*"
                                      HeightRequest="26">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAspectMercuryTapped" />
                                    </Grid.GestureRecognizers>
                                    <Border x:Name="AspectMercuryBox"
                                            Grid.Column="0"
                                            WidthRequest="18"
                                            HeightRequest="18"
                                            Stroke="#5A46FF"
                                            StrokeThickness="2"
                                            BackgroundColor="Transparent"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center">
                                        <Label x:Name="AspectMercuryCheck"
                                               Text="✓"
                                               IsVisible="False"
                                               FontSize="11"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                    <Label x:Name="LabelAspectMercury"
                                           Grid.Column="1"
                                           FontSize="14"
                                           LineBreakMode="NoWrap"
                                           VerticalOptions="Center" />
                                </Grid>

                                <Grid Grid.Row="1" Grid.Column="2"
                                      ColumnDefinitions="22,*"
                                      HeightRequest="26">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAspectJupiterTapped" />
                                    </Grid.GestureRecognizers>
                                    <Border x:Name="AspectJupiterBox"
                                            Grid.Column="0"
                                            WidthRequest="18"
                                            HeightRequest="18"
                                            Stroke="#5A46FF"
                                            StrokeThickness="2"
                                            BackgroundColor="Transparent"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center">
                                        <Label x:Name="AspectJupiterCheck"
                                               Text="✓"
                                               IsVisible="False"
                                               FontSize="11"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                    <Label x:Name="LabelAspectJupiter"
                                           Grid.Column="1"
                                           FontSize="14"
                                           LineBreakMode="NoWrap"
                                           VerticalOptions="Center" />
                                </Grid>

                                <!-- Row 3 -->
                                <Grid Grid.Row="2" Grid.Column="0"
                                      ColumnDefinitions="22,*"
                                      HeightRequest="26">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAspectVenusTapped" />
                                    </Grid.GestureRecognizers>
                                    <Border x:Name="AspectVenusBox"
                                            Grid.Column="0"
                                            WidthRequest="18"
                                            HeightRequest="18"
                                            Stroke="#5A46FF"
                                            StrokeThickness="2"
                                            BackgroundColor="Transparent"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center">
                                        <Label x:Name="AspectVenusCheck"
                                               Text="✓"
                                               IsVisible="False"
                                               FontSize="11"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                    <Label x:Name="LabelAspectVenus"
                                           Grid.Column="1"
                                           FontSize="14"
                                           LineBreakMode="NoWrap"
                                           VerticalOptions="Center" />
                                </Grid>

                                <Grid Grid.Row="2" Grid.Column="1"
                                      ColumnDefinitions="22,*"
                                      HeightRequest="26">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAspectSaturnTapped" />
                                    </Grid.GestureRecognizers>
                                    <Border x:Name="AspectSaturnBox"
                                            Grid.Column="0"
                                            WidthRequest="18"
                                            HeightRequest="18"
                                            Stroke="#5A46FF"
                                            StrokeThickness="2"
                                            BackgroundColor="Transparent"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center">
                                        <Label x:Name="AspectSaturnCheck"
                                               Text="✓"
                                               IsVisible="False"
                                               FontSize="11"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                    <Label x:Name="LabelAspectSaturn"
                                           Grid.Column="1"
                                           FontSize="14"
                                           LineBreakMode="NoWrap"
                                           VerticalOptions="Center" />
                                </Grid>

                                <Grid Grid.Row="2" Grid.Column="2"
                                      ColumnDefinitions="22,*"
                                      HeightRequest="26">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAspectRahuTapped" />
                                    </Grid.GestureRecognizers>
                                    <Border x:Name="AspectRahuBox"
                                            Grid.Column="0"
                                            WidthRequest="18"
                                            HeightRequest="18"
                                            Stroke="#5A46FF"
                                            StrokeThickness="2"
                                            BackgroundColor="Transparent"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center">
                                        <Label x:Name="AspectRahuCheck"
                                               Text="✓"
                                               IsVisible="False"
                                               FontSize="11"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                    <Label x:Name="LabelAspectRahu"
                                           Grid.Column="1"
                                           FontSize="14"
                                           LineBreakMode="NoWrap"
                                           VerticalOptions="Center" />
                                </Grid>

                            </Grid>
                        </Border>

                    </Grid>

                    <Label x:Name="LabelPlanetsTransitPositions"
                           FontSize="12"
                           FontAttributes="Bold"
                           Margin="0,2,0,0" />

                    <Border Stroke="#BDBDBD"
                            StrokeThickness="1"
                            BackgroundColor="Transparent"
                            Padding="0"
                            Margin="0,0,0,0">

                        <Grid RowDefinitions="Auto,*">

                            <!-- header -->
                            <Grid Grid.Row="0"
                                  BackgroundColor="#EFE8C8"
                                  ColumnDefinitions="20,60,78,*,36,64"
                                  Padding="4,3">
                                <Label Grid.Column="0" 
                                       Text="" 
                                       FontSize="10" 
                                       FontAttributes="Bold" />
                                <Label x:Name="TableLabelDegree"
                                       Grid.Column="1" 
                                       FontSize="10" 
                                       FontAttributes="Bold" />
                                <Label x:Name="TableLabelRasi"
                                       Grid.Column="2" 
                                       FontSize="10" 
                                       FontAttributes="Bold" />
                                <Label x:Name="TableLabelNakshatra"
                                       Grid.Column="3" 
                                       FontSize="10" 
                                       FontAttributes="Bold" />
                                <Label x:Name="TableLabelPada"
                                       Grid.Column="4" 
                                       FontSize="10" 
                                       FontAttributes="Bold" 
                                       HorizontalTextAlignment="Center" />
                                <Label x:Name="TableLabelNavamsa"
                                       Grid.Column="5" 
                                       Text="Навамша" 
                                       FontSize="10" 
                                       FontAttributes="Bold" />
                            </Grid>

                            <!-- rows -->
                            <CollectionView x:Name="TransitPlanetTableView"
                                            Grid.Row="1"
                                            SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="20,60,78,*,36,64"
                                              Padding="4,3">
                                            <Label Grid.Column="0" Text="{Binding Planet}" FontSize="10" />
                                            <Label Grid.Column="1" Text="{Binding Degree}" FontSize="10" />
                                            <Label Grid.Column="2" Text="{Binding Zodiac}" FontSize="10" />
                                            <Label Grid.Column="3" Text="{Binding Nakshatra}" FontSize="10" LineBreakMode="TailTruncation" />
                                            <Label Grid.Column="4" Text="{Binding Pada}" FontSize="10" HorizontalTextAlignment="Center" />
                                            <Label Grid.Column="5" Text="{Binding Navamsha}" FontSize="10" LineBreakMode="TailTruncation" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Border>


                </VerticalStackLayout>
            </ScrollView>

        </Grid>

        <!-- Floating dropdown -->
        <Border x:Name="NatalReferencePanel"
                IsVisible="False"
                AbsoluteLayout.LayoutBounds="251,28,110,-1"
                AbsoluteLayout.LayoutFlags="None"
                Stroke="#D0D0D0"
                StrokeThickness="1"
                Padding="6,4"
                BackgroundColor="White"
                ZIndex="20">

            <!-- список Lagna / Sun / Moon / ... -->
            <VerticalStackLayout Spacing="0">

                <Grid HeightRequest="26">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNatalReferenceLagnaTapped" CommandParameter="0" />
                    </Grid.GestureRecognizers>
                    <Label x:Name="NatalRefLagnaLabel"
                           FontSize="15"
                           VerticalOptions="Center" />
                </Grid>

                <Grid HeightRequest="26">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNatalReferenceSunTapped" CommandParameter="1" />
                    </Grid.GestureRecognizers>
                    <Label x:Name="NatalRefSunLabel"
                           FontSize="15"
                           VerticalOptions="Center" />
                </Grid>

                <Grid HeightRequest="26">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNatalReferenceMoonTapped" CommandParameter="2" />
                    </Grid.GestureRecognizers>
                    <Label x:Name="NatalRefMoonLabel"
                           FontSize="15"
                           VerticalOptions="Center" />
                </Grid>

                <Grid HeightRequest="26">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNatalReferenceMarsTapped" CommandParameter="3" />
                    </Grid.GestureRecognizers>
                    <Label x:Name="NatalRefMarsLabel"
                           FontSize="15"
                           VerticalOptions="Center" />
                </Grid>

                <Grid HeightRequest="26">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNatalReferenceMercuryTapped" CommandParameter="4" />
                    </Grid.GestureRecognizers>
                    <Label x:Name="NatalRefMercuryLabel"
                           FontSize="15"
                           VerticalOptions="Center" />
                </Grid>

                <Grid HeightRequest="26">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNatalReferenceJupiterTapped" CommandParameter="5" />
                    </Grid.GestureRecognizers>
                    <Label x:Name="NatalRefJupiterLabel"
                           FontSize="15"
                           VerticalOptions="Center" />
                </Grid>

                <Grid HeightRequest="26">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNatalReferenceVenusTapped" CommandParameter="6" />
                    </Grid.GestureRecognizers>
                    <Label x:Name="NatalRefVenusLabel"
                           FontSize="15"
                           VerticalOptions="Center" />
                </Grid>

                <Grid HeightRequest="26">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNatalReferenceSaturnTapped" CommandParameter="7" />
                    </Grid.GestureRecognizers>
                    <Label x:Name="NatalRefSaturnLabel"
                           FontSize="15"
                           VerticalOptions="Center" />
                </Grid>

                <Grid HeightRequest="26">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNatalReferenceRahuTapped" CommandParameter="8" />
                    </Grid.GestureRecognizers>
                    <Label x:Name="NatalRefRahuLabel"
                           FontSize="15"
                           VerticalOptions="Center" />
                </Grid>

                <Grid HeightRequest="26">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNatalReferenceKetuTapped" CommandParameter="9" />
                    </Grid.GestureRecognizers>
                    <Label x:Name="NatalRefKetuLabel"
                           FontSize="15"
                           VerticalOptions="Center" />
                </Grid>

            </VerticalStackLayout>
        </Border>

        <Border x:Name="StepUnitPanel"
                IsVisible="False"
                BackgroundColor="White"
                Stroke="#D0D0D0"
                StrokeThickness="1"
                Padding="6,4"
                AbsoluteLayout.LayoutBounds="0.78,0.84,110,-1"
                AbsoluteLayout.LayoutFlags="PositionProportional">
            <VerticalStackLayout Spacing="0">

                <Label Text="Seconds"
                       FontSize="15"
                       TextColor="Black"
                       BackgroundColor="White">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnStepSecondsTapped" />
                    </Label.GestureRecognizers>
                </Label>

                <Label Text="Minutes"
                       FontSize="15"
                       TextColor="Black"
                       BackgroundColor="White">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnStepMinutesTapped" />
                    </Label.GestureRecognizers>
                </Label>

                <Label Text="Hours"
                       FontSize="15"
                       TextColor="Black"
                       BackgroundColor="White">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnStepHoursTapped" />
                    </Label.GestureRecognizers>
                </Label>

                <Label Text="Days"
                       FontSize="15"
                       TextColor="Black"
                       BackgroundColor="White">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnStepDaysTapped" />
                    </Label.GestureRecognizers>
                </Label>

                <Label Text="Months"
                       FontSize="15"
                       TextColor="Black"
                       BackgroundColor="White">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnStepMonthsTapped" />
                    </Label.GestureRecognizers>
                </Label>

                <Label Text="Years"
                       FontSize="15"
                       TextColor="Black"
                       BackgroundColor="White">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnStepYearsTapped" />
                    </Label.GestureRecognizers>
                </Label>

            </VerticalStackLayout>
        </Border>

    </AbsoluteLayout>
</ui:ConfigBasePage>