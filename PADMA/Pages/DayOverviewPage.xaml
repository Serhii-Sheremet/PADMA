<?xml version="1.0" encoding="utf-8" ?>
<ui:ConfigBasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ui="clr-namespace:PADMA.UI.Templates;assembly=PADMA"
    xmlns:local="clr-namespace:PADMA.UI"
    x:Class="PADMA.Pages.DayOverviewPage">

    <!-- ВНИМАНИЕ:
         ConfigBasePage уже содержит ScrollView внутри.
         Но в проекте дочерние конфиг-страницы тоже часто кладут свой ScrollView — это ок.
         Чтобы не плодить вложенный ScrollView, здесь используем просто VerticalStackLayout. -->

    <VerticalStackLayout Spacing="0" Padding="0">

        <!-- Panchanga bars (крупнее, чем в календаре) -->
        <VerticalStackLayout Spacing="0" Margin="0,0,0,2">

            <!--<Label x:Name="NakshatraLabel" FontSize="12" TextColor="#333" />-->
            <local:PanchangaBar Margin="0" HeightRequest="24"
                                DayDate="{Binding Day.Date}"
                                Segments="{Binding Day.NakshatraSegments}" />

            <!--<Label x:Name="TaraBalaLabel" FontSize="12" TextColor="#333" />-->
            <local:PanchangaBar Margin="0" HeightRequest="24"
                                DayDate="{Binding Day.Date}"
                                Segments="{Binding Day.TaraBalaSegments}" />

            <!--<Label x:Name="TithiLabel" FontSize="12" TextColor="#333" />-->
            <local:PanchangaBar Margin="0" HeightRequest="24"
                                DayDate="{Binding Day.Date}"
                                Segments="{Binding Day.TithiSegments}" />

            <!--<Label x:Name="KaranaLabel" FontSize="12" TextColor="#333" />-->
            <local:PanchangaBar Margin="0" HeightRequest="24"
                                DayDate="{Binding Day.Date}"
                                Segments="{Binding Day.KaranaSegments}" />

            <!--<Label x:Name="NityaYogaLabel" FontSize="12" TextColor="#333" />-->
            <local:PanchangaBar Margin="0" HeightRequest="24"
                                DayDate="{Binding Day.Date}"
                                Segments="{Binding Day.NityaYogaSegments}" />

            <!--<Label x:Name="ChandraBalaLabel" FontSize="12" TextColor="#333" />-->
            <local:PanchangaBar Margin="0" HeightRequest="24"
                                DayDate="{Binding Day.Date}"
                                Segments="{Binding Day.ChandraBalaSegments}" />
        </VerticalStackLayout>
        
        <!-- Кнопка перехода на DayPage -->
        <Button Margin="12"
            x:Name="OpenDayDetailsButton"
            Text="Open Day Details"
            CornerRadius="10"
            HeightRequest="34"
            Clicked="OnOpenDayDetailsClicked" />
    </VerticalStackLayout>
</ui:ConfigBasePage>
