<?xml version="1.0" encoding="utf-8" ?>
<ui:ConfigBasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ui="clr-namespace:PADMA.UI.Templates;assembly=PADMA"
    xmlns:local="clr-namespace:PADMA.UI"
    x:Class="PADMA.Pages.DayOverviewPage">

        <!-- ATTENTION:
         ConfigBasePage already has ScrollView inside.
         But in the project, child config pages also often put their own ScrollView — it's OK.
         To avoid creating nested ScrollView, just using VerticalStackLayout here. -->

    <Grid RowDefinitions="*,Auto"
          RowSpacing="0">

        <CarouselView x:Name="DayCarousel"
              Loop="False"
              Grid.Row="0"
              IsSwipeEnabled="True"
              PositionChanged="OnCarouselPositionChanged">

            <CarouselView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal"
                       SnapPointsType="MandatorySingle"
                       SnapPointsAlignment="Center" />
            </CarouselView.ItemsLayout>

            <CarouselView.ItemTemplate>
                <DataTemplate>

                    <ScrollView Grid.Row="0">

                        <!-- ONE root content for ScrollView -->
                        <VerticalStackLayout Spacing="0">

                            <!-- Eclipse (only if exists) -->
                            <Grid ColumnDefinitions="Auto,*"
                                  Padding="0,0,0,2"
                                  IsVisible="{Binding Overview.HasEclipse, TargetNullValue=False}">

                                <Image Grid.Column="0"
                                       Source="{Binding Overview.EclipseIcon}"
                                       WidthRequest="24"
                                       HeightRequest="24"
                                       Margin="0,0,30,0"
                                       VerticalOptions="Center" />

                                <Label Grid.Column="1"
                                       Text="{Binding Overview.EclipseText}"
                                       Opacity="0.75"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       LineBreakMode="TailTruncation" />
                            </Grid>

                            <!-- Sunrise / Sunset (top) -->
                            <Grid ColumnDefinitions="*,*"
                                  Padding="0,0,0,2"
                                  RowDefinitions="Auto">

                                <!-- Sunrise -->
                                <HorizontalStackLayout Grid.Column="0"
                                        Spacing="6"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Center">
                                    <Label Text= "{Binding Overview.SunriseLabelText}"
                                           FontSize="12" />
                                    <Label Text="{Binding Overview.SunriseText}"
                                           FontSize="12"
                                           FontAttributes="Bold" />
                                </HorizontalStackLayout>

                                <!-- Sunset -->
                                <HorizontalStackLayout Grid.Column="1"
                                        Spacing="6"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding Overview.SunsetLabelText}"
                                           FontSize="12" />
                                    <Label Text="{Binding Overview.SunsetText}"
                                           FontSize="12"
                                           FontAttributes="Bold" />
                                </HorizontalStackLayout>

                            </Grid>

                            <!-- Panchanga bars (larger than on the calendar) -->
                            <VerticalStackLayout Spacing="0" Margin="0,0,0,2">

                                <local:PanchangaBar Margin="0" HeightRequest="24"
                                        DayDate="{Binding Day.Date}"
                                        Segments="{Binding Day.NakshatraSegments}" />

                                <local:PanchangaBar Margin="0" HeightRequest="24"
                                        DayDate="{Binding Day.Date}"
                                        Segments="{Binding Day.TaraBalaSegments}" />

                                <local:PanchangaBar Margin="0" HeightRequest="24"
                                        DayDate="{Binding Day.Date}"
                                        Segments="{Binding Day.TithiSegments}" />

                                <local:PanchangaBar Margin="0" HeightRequest="24"
                                        DayDate="{Binding Day.Date}"
                                        Segments="{Binding Day.KaranaSegments}" />

                                <local:PanchangaBar Margin="0" HeightRequest="24"
                                        DayDate="{Binding Day.Date}"
                                        Segments="{Binding Day.NityaYogaSegments}" />

                                <local:PanchangaBar Margin="0" HeightRequest="24"
                                        DayDate="{Binding Day.Date}"
                                        Segments="{Binding Day.ChandraBalaSegments}" />
                            </VerticalStackLayout>

                            <!-- Planet stripes (9 bars) -->
                            <VerticalStackLayout x:Name="PlanetStripesHost"
                                                 Spacing="0"
                                                 Margin="0,2,0,0"
                                                 BindableLayout.ItemsSource="{Binding Overview.PlanetStripes}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <local:PanchangaBar HeightRequest="24"
                                                            DayDate="{Binding DayDate}"
                                                            Segments="{Binding Segments}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- MUHURTAS (one block, 5 stripes) -->
                            <VerticalStackLayout Margin="0,4,0,0"
                                     Spacing="0"
                                     BindableLayout.ItemsSource="{Binding Overview.MuhurtaStripes}">

                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <local:MuhurtaBar HeightRequest="24"
                                              DayDate="{Binding DayStartLocal}"
                                              Stripe="{Binding .}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- YOGAS (below Muhurtas) -->
                            <VerticalStackLayout Margin="0,4,0,0"
                                     Spacing="0"
                                     BindableLayout.ItemsSource="{Binding Overview.YogaStripes}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <local:YogaBar HeightRequest="24"
                                           DayDate="{Binding DayStartLocal}"
                                           Stripe="{Binding .}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>

                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <!-- Button for navigating to DayPage -->
        <Button Grid.Row="1"
                Margin="12"
                x:Name="OpenDayDetailsButton"
                BackgroundColor="#2196F3"
                TextColor="White"
                Text="Open Day Details"
                CornerRadius="10"
                HeightRequest="34"
                Clicked="OnOpenDayDetailsClicked" />

        <!--  Busy overlay -->
        <Grid IsVisible="{Binding IsBusy, FallbackValue=False}"
              InputTransparent="False"
              BackgroundColor="#80000000"
              ZIndex="999">

            <VerticalStackLayout
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="12">

                <ActivityIndicator
                    IsRunning="True"
                    WidthRequest="48"
                    HeightRequest="48" />

                <Label Text="{Binding BusyText}"
                       TextColor="White"
                       FontSize="Medium"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ui:ConfigBasePage>
