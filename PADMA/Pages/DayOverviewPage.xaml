<?xml version="1.0" encoding="utf-8" ?>
<ui:ConfigBasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ui="clr-namespace:PADMA.UI.Templates;assembly=PADMA"
    xmlns:local="clr-namespace:PADMA.UI"
    x:Class="PADMA.Pages.DayOverviewPage">

    <!-- ATTENTION:
         ConfigBasePage already has ScrollView inside.
         But in the project, child config pages also often put their own ScrollView — it's OK.
         To avoid creating nested ScrollView, just using VerticalStackLayout here. -->

    <VerticalStackLayout Spacing="0" Padding="0">

        <!-- Sunrise / Sunset (top) -->
        <Grid ColumnDefinitions="*,*"
            Padding="0,0,0,2"
            RowDefinitions="Auto">

            <!-- Sunrise -->
            <HorizontalStackLayout Grid.Column="0"
                           Spacing="6"
                           HorizontalOptions="Start"
                           VerticalOptions="Center">
                <Label Text= "{Binding OverviewData.SunriseLabelText}"
                    Opacity="0.75" />
                <Label Text="{Binding OverviewData.SunriseText}"
                    FontAttributes="Bold" />
            </HorizontalStackLayout>

            <!-- Sunset -->
            <HorizontalStackLayout Grid.Column="1"
                           Spacing="6"
                           HorizontalOptions="End"
                           VerticalOptions="Center">
                <Label Text="{Binding OverviewData.SunsetLabelText}"
                    Opacity="0.75" />
                <Label Text="{Binding OverviewData.SunsetText}"
                    FontAttributes="Bold" />
            </HorizontalStackLayout>

        </Grid>


        <!-- Panchanga bars (larger than on the calendar) -->
        <VerticalStackLayout Spacing="0" Margin="0,0,0,2">

            <local:PanchangaBar Margin="0" HeightRequest="24"
                                DayDate="{Binding Day.Date}"
                                Segments="{Binding Day.NakshatraSegments}" />

            <local:PanchangaBar Margin="0" HeightRequest="24"
                                DayDate="{Binding Day.Date}"
                                Segments="{Binding Day.TaraBalaSegments}" />

            <local:PanchangaBar Margin="0" HeightRequest="24"
                                DayDate="{Binding Day.Date}"
                                Segments="{Binding Day.TithiSegments}" />

            <local:PanchangaBar Margin="0" HeightRequest="24"
                                DayDate="{Binding Day.Date}"
                                Segments="{Binding Day.KaranaSegments}" />

            <local:PanchangaBar Margin="0" HeightRequest="24"
                                DayDate="{Binding Day.Date}"
                                Segments="{Binding Day.NityaYogaSegments}" />

            <local:PanchangaBar Margin="0" HeightRequest="24"
                                DayDate="{Binding Day.Date}"
                                Segments="{Binding Day.ChandraBalaSegments}" />
        </VerticalStackLayout>

        <!-- Planet stripes (9 bars) -->
        <VerticalStackLayout Spacing="0" Margin="0,2,0,0"
                     BindableLayout.ItemsSource="{Binding OverviewData.PlanetStripes}">
            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <local:PanchangaBar HeightRequest="24"
                    DayDate="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                     Path=BindingContext.Day.Date}"
                    Segments="{Binding Segments}" />
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <!-- MUHURTAS (one block, 5 stripes) -->
        <VerticalStackLayout Margin="0,2,0,0"
                     Spacing="0"
                     BindableLayout.ItemsSource="{Binding OverviewData.MuhurtaStripes}">

            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <local:MuhurtaBar HeightRequest="24"
                           DayDate="{Binding DayStartLocal}"
                           Stripe="{Binding .}" />
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>



        <!-- Button for navigating to DayPage -->
        <Button Margin="12"
            x:Name="OpenDayDetailsButton"
            Text="Open Day Details"
            CornerRadius="10"
            HeightRequest="34"
            Clicked="OnOpenDayDetailsClicked" />
    </VerticalStackLayout>
</ui:ConfigBasePage>
