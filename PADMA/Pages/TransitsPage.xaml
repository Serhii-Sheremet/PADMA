<?xml version="1.0" encoding="utf-8" ?>
<ui:ConfigBasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ui="clr-namespace:PADMA.UI.Templates;assembly=PADMA"
    x:Class="PADMA.Pages.TransitsPage">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Заголовок страницы -->
            <Label x:Name="HeaderLabel"
                   Style="{StaticResource PageTitleStyle}"
                   HorizontalOptions="Start" />

            <!-- Радиокнопки -->
            <Grid ColumnSpacing="12" RowSpacing="16"
                  ColumnDefinitions="Auto,*"
                  RowDefinitions="Auto,Auto,Auto">

                <!-- From natal Moon -->
                <RadioButton x:Name="RbFromMoon"
                             Grid.Row="0" Grid.Column="0"
                             GroupName="TransitOptions"
                             CheckedChanged="OnOptionCheckedChanged" />
                <Label x:Name="LblFromMoon"
                       Grid.Row="0" Grid.Column="1"
                       VerticalOptions="Center"
                       Style="{StaticResource LabelTextStyle}" />

                <!-- From Ascendant (Lagna) -->
                <RadioButton x:Name="RbFromAsc"
                             Grid.Row="1" Grid.Column="0"
                             GroupName="TransitOptions"
                             CheckedChanged="OnOptionCheckedChanged" />
                <Label x:Name="LblFromAsc"
                       Grid.Row="1" Grid.Column="1"
                       VerticalOptions="Center"
                       Style="{StaticResource LabelTextStyle}" />

                <!-- From both -->
                <RadioButton x:Name="RbFromBoth"
                             Grid.Row="2" Grid.Column="0"
                             GroupName="TransitOptions"
                             CheckedChanged="OnOptionCheckedChanged" />
                <Label x:Name="LblFromBoth"
                       Grid.Row="2" Grid.Column="1"
                       VerticalOptions="Center"
                       Style="{StaticResource LabelTextStyle}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ui:ConfigBasePage>
