<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PADMA.Pages.LocationSearchPage"
             Title="Location search">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20" RowSpacing="10">

        <!-- Верхняя панель: страна + локация -->
        <VerticalStackLayout Grid.Row="0" Spacing="10">

            <!-- Страна -->
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <Label Text="Country" FontAttributes="Bold" />
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <!-- можно сделать Entry read-only -->
                    <Entry x:Name="entryCountry"
                       Grid.Column="0"
                       Placeholder="Select country"
                       IsReadOnly="True"
                       ClearButtonVisibility="Never" />

                    <ImageButton x:Name="btnCountry"
                             Grid.Column="1"
                             Source="search_icon.png"
                             HeightRequest="28"
                             WidthRequest="28"
                             BackgroundColor="Transparent"
                             Clicked="OnCountryClicked"
                             ToolTipProperties.Text="Select country"
                             VerticalOptions="Center" />
                </Grid>
            </Grid>

            <!-- Локация -->
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <Label Text="Location" FontAttributes="Bold" />
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry x:Name="entrySearch"
                       Grid.Column="0"
                       Placeholder="Enter city name"
                       Completed="OnSearchClicked"
                       ClearButtonVisibility="WhileEditing"
                       HorizontalOptions="Fill"
                       VerticalOptions="Center"
                       BackgroundColor="Transparent"
                       Margin="0" 
                       TextChanged="OnSearchTextChanged"/>

                    <ImageButton x:Name="btnSearch"
                             Grid.Column="1"
                             Source="search_icon.png"
                             HeightRequest="28"
                             WidthRequest="28"
                             BackgroundColor="Transparent"
                             Clicked="OnSearchClicked"
                             ToolTipProperties.Text="Search"
                             VerticalOptions="Center" />
                </Grid>
            </Grid>

        </VerticalStackLayout>

        <!-- Индикатор загрузки -->
        <ActivityIndicator x:Name="loadingIndicator"
                           Grid.Row="1"
                           IsRunning="False"
                           IsVisible="False"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           Color="Gray" />

        <!-- Список результатов -->
        <CollectionView x:Name="listResults"
                        Grid.Row="1"
                        SelectionMode="None"
                        Margin="0,10,0,60">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="8"
                           Margin="5,2"
                           BorderColor="LightGray"
                           CornerRadius="8">

                        <Frame.Triggers>
                            <DataTrigger TargetType="Frame"
                                         Binding="{Binding IsSelected}"
                                         Value="True">
                                <Setter Property="BackgroundColor" Value="#FFF7D6" />
                                <Setter Property="BorderColor" Value="#FFC107" />
                            </DataTrigger>
                        </Frame.Triggers>

                        <VerticalStackLayout>
                            <Label Text="{Binding DisplayName}" FontSize="16" />
                            <Label Text="{Binding CoordinatesString}"
                                   FontSize="12"
                                   TextColor="DarkGray" />
                        </VerticalStackLayout>

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ItemTappedCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Кнопка "Выбрать" (фиксированная внизу) -->
        <Grid Grid.Row="2" Padding="0,5,0,10">
            <Button x:Name="btnSelect"
                    Text="Select"
                    IsEnabled="False"
                    Clicked="OnSelectClicked"
                    HeightRequest="44"
                    FontAttributes="Bold"
                    HorizontalOptions="FillAndExpand"
                    BackgroundColor="#2196F3"
                    TextColor="White"
                    CornerRadius="10" />
        </Grid>
    </Grid>
</ContentPage>
