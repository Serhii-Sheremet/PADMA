<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PADMA.Pages.LocationSearchPage"
             Title="Location search">

    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="close_icon.png"
                     Priority="0"
                     Order="Primary"
                     Clicked="OnCloseClicked" />
    </ContentPage.ToolbarItems>

    <VerticalStackLayout Padding="20" Spacing="12">

        <HorizontalStackLayout Spacing="8">
            <Entry x:Name="entrySearch"
                   Placeholder="Enter city name"
                   HorizontalOptions="FillAndExpand"
                   Completed="OnSearchClicked" />

            <ImageButton Source="search_icon.png"
                         HeightRequest="32"
                         WidthRequest="32"
                         Clicked="OnSearchClicked"
                         BackgroundColor="Transparent"
                         ToolTipProperties.Text="Search" />

            <Button x:Name="btnSelect"
                    Text="Select"
                    IsEnabled="False"
                    Clicked="OnSelectClicked"
                    VerticalOptions="Center"
                    HorizontalOptions="End"
                    WidthRequest="90"
                    HeightRequest="36"
                    FontSize="12" />
        </HorizontalStackLayout>

        <ActivityIndicator x:Name="loadingIndicator"
                           IsRunning="False"
                           IsVisible="False"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           Color="Gray" />

        <CollectionView x:Name="listResults"
                        SelectionMode="Single"
                        SelectionChanged="OnLocationSelected"
                        Margin="0,10,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="8"
                           Margin="5,2"
                           BorderColor="LightGray"
                           CornerRadius="8">
                        <VerticalStackLayout>
                            <Label Text="{Binding DisplayName}" FontSize="16" />
                            <Label Text="{Binding CoordinatesString}"
                                   FontSize="12"
                                   TextColor="DarkGray" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
