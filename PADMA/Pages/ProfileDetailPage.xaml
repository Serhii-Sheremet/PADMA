<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PADMA.Pages.ProfileDetailPage"
             Title="Profile">

    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="close_icon.png"
                     Priority="0"
                     Order="Primary"
                     Clicked="OnCloseClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="12">

                <Entry x:Name="entryProfileName"
                       Placeholder="Profile name"
                       Text="{Binding ProfileName}" />

                <Entry x:Name="entryPersonName"
                       Placeholder="First name"
                       Text="{Binding PersonName}" />

                <Entry x:Name="entryPersonSurname"
                       Placeholder="Last name"
                       Text="{Binding PersonSurname}" />

                <Label x:Name="lblDateTimeOfBirth"
                       Text="Date and time of birth"
                       FontAttributes="Bold" />

                <HorizontalStackLayout Spacing="10">
                    <DatePicker x:Name="dateOfBirthDate"
                                Date="{Binding DateOfBirth, Mode=OneWay}" />
                    <TimePicker x:Name="timeOfBirthTime"
                                Format="HH:mm:ss"
                                Time="{Binding DateOfBirth, Converter={StaticResource DateTimeToTimeSpanConverter}, Mode=OneWay}" />
                </HorizontalStackLayout>

                <!-- Место рождения -->
                <Label x:Name="lblPlaceOfBirth" Text="Place of birth" FontAttributes="Bold" />
                <Grid>
                    <Label x:Name="lblPlaceOfBirthValue"
                           VerticalOptions="Center"
                           TextColor="Black"
                           FontAttributes="Italic"
                           Padding="4,8" />

                    <!-- Прозрачный слой для тапа по всей области -->
                    <BoxView BackgroundColor="Transparent">
                        <BoxView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPlaceOfBirthClicked" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                </Grid>
                <BoxView HeightRequest="1" Color="LightGray" Margin="0,0,0,8"/>

                <!-- Место проживания -->
                <Label x:Name="lblPlaceOfLiving" Text="Place of living" FontAttributes="Bold" />
                <Grid>
                    <Label x:Name="lblPlaceOfLivingValue"
                           VerticalOptions="Center"
                           TextColor="Black"
                           FontAttributes="Italic"
                           Padding="4,8" />

                    <BoxView BackgroundColor="Transparent">
                        <BoxView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPlaceOfLivingClicked" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                </Grid>
                <BoxView HeightRequest="1" Color="LightGray" Margin="0,0,0,8"/>

                <Editor x:Name="entryMessage"
                        Placeholder="Notes"
                        Text="{Binding Message}"
                        AutoSize="TextChanges" />
                
            </VerticalStackLayout>
        </ScrollView>

        <Button x:Name="btnBirthChartPreview"
                Grid.Row="1"
                Margin="20,0,20,8"
                HeightRequest="44"
                FontAttributes="Bold"
                HorizontalOptions="FillAndExpand"
                BackgroundColor="#2196F3"
                TextColor="White"
                CornerRadius="10"
                Clicked="OnBirthChartPreviewClicked" />

        <!-- Нижняя панель -->
        <Grid Grid.Row="2"
              Padding="16,20"
              ColumnDefinitions="*,*,*"
              BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111111}">

            <!-- Save -->
            <ImageButton x:Name="btnSave"
                     Grid.Column="0"
                     Source="save_icon.png"
                     Clicked="OnSaveClicked"
                     HorizontalOptions="Center"
                     VerticalOptions="Center"
                     HeightRequest="42"
                     WidthRequest="42"/>

            <!-- Edit -->
            <ImageButton x:Name="btnEdit"
                     Grid.Column="1"
                     Source="edit_icon.png"
                     Clicked="OnEditClicked"
                     HorizontalOptions="Center"
                     VerticalOptions="Center"
                     HeightRequest="42"
                     WidthRequest="42"/>

            <!-- Delete -->
            <ImageButton x:Name="btnDelete"
                     Grid.Column="2"
                     Source="delete_icon.png"
                     Clicked="OnDeleteClicked"
                     HorizontalOptions="Center"
                     VerticalOptions="Center"
                     HeightRequest="42"
                     WidthRequest="42"/>
        </Grid>

    </Grid>
</ContentPage>
