<?xml version="1.0" encoding="utf-8" ?>
<ui:ConfigBasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ui="clr-namespace:PADMA.UI.Templates;assembly=PADMA"
    x:Class="PADMA.Pages.NodesPage"
    Title="Nodes (Rahu and Ketu)">

    <!-- ВАЖНО: без ScrollView, его уже даёт ConfigBasePage -->
    <VerticalStackLayout Padding="16" Spacing="16">

        <!-- Заголовок страницы: лучше убрать, если используешь TitleLabel шаблона -->
        <!-- Если хочешь свой заголовок — тогда в шаблоне скрывай TitleLabel -->
        <Label x:Name="HeaderLabel"
               Style="{StaticResource PageTitleStyle}"
               HorizontalOptions="Start" />

        <Grid ColumnSpacing="12" RowSpacing="16"
              ColumnDefinitions="Auto,*"
              RowDefinitions="Auto,Auto">

            <RadioButton x:Name="MeanRadioButton"
                         Grid.Row="0" Grid.Column="0"
                         GroupName="NodesOption"
                         CheckedChanged="OnRadioButtonCheckedChanged" />

            <Label x:Name="MeanLabel"
                   Grid.Row="0" Grid.Column="1"
                   VerticalOptions="Center"
                   Style="{StaticResource LabelTextStyle}" />

            <RadioButton x:Name="TrueRadioButton"
                         Grid.Row="1" Grid.Column="0"
                         GroupName="NodesOption"
                         CheckedChanged="OnRadioButtonCheckedChanged" />

            <Label x:Name="TrueLabel"
                   Grid.Row="1" Grid.Column="1"
                   VerticalOptions="Center"
                   Style="{StaticResource LabelTextStyle}" />
        </Grid>

    </VerticalStackLayout>
</ui:ConfigBasePage>