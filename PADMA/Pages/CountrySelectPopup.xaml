<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="PADMA.Pages.CountrySelectPopup">

    <Border StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
            Padding="12" StrokeShape="RoundRectangle 16">
        <VerticalStackLayout Spacing="10" WidthRequest="320">

            <Label x:Name="lblTitle" Text="Select country" FontAttributes="Bold" />

            <SearchBar x:Name="sb" Placeholder="Search..." TextChanged="OnSearchChanged"/>

            <CollectionView x:Name="cv" 
                            HeightRequest="360"
                            SelectionMode="Single" 
                            SelectionChanged="OnSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8">
                            <Label Text="{Binding Display}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </Border>
</toolkit:Popup>