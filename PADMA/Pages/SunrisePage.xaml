<?xml version="1.0" encoding="utf-8" ?>
<ui:ConfigBasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ui="clr-namespace:PADMA.UI.Templates;assembly=PADMA"
    x:Class="PADMA.Pages.SunrisePage">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Заголовок -->
            <Label x:Name="HeaderLabel"
                   Style="{StaticResource PageTitleStyle}"
                   HorizontalOptions="Start" />

            <!-- Радиокнопки -->
            <Grid ColumnSpacing="12" RowSpacing="16"
                  ColumnDefinitions="Auto,*"
                  RowDefinitions="Auto,Auto">

                <!-- Option 1 -->
                <RadioButton x:Name="TipRadioButton"
                             Grid.Row="0" Grid.Column="0"
                             GroupName="Sunrise"
                             CheckedChanged="OnRadioButtonCheckedChanged" />

                <Label x:Name="TipLabel"
                       Grid.Row="0" Grid.Column="1"
                       VerticalOptions="Center"
                       Style="{StaticResource LabelTextStyle}" />

                <!-- Option 2 -->
                <RadioButton x:Name="CenterRadioButton"
                             Grid.Row="1" Grid.Column="0"
                             GroupName="Sunrise"
                             CheckedChanged="OnRadioButtonCheckedChanged" />

                <Label x:Name="CenterLabel"
                       Grid.Row="1" Grid.Column="1"
                       VerticalOptions="Center"
                       Style="{StaticResource LabelTextStyle}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ui:ConfigBasePage>
