<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PADMA.Pages.LanguagePage"
             Title="{x:Static local:Localization.LanguageTitle}"
             xmlns:local="clr-namespace:PADMA.Core.Utilities">

    <ContentPage.ToolbarItems>
        <!-- Крестик для закрытия страницы -->
        <ToolbarItem IconImageSource="close_icon.png"
                     Order="Primary"
                     Priority="0"
                     Clicked="OnCloseClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Заголовок -->
            <Label Text="{x:Static local:Localization.SelectLanguageLabel}"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <!-- Список языков -->
            <VerticalStackLayout Spacing="15">

                <!-- English -->
                <RadioButton x:Name="EnglishRadioButton"
                             GroupName="LanguageSelection"
                             CheckedChanged="OnRadioButtonCheckedChanged">
                    <RadioButton.Content>
                        <HorizontalStackLayout Spacing="10">
                            <Image Source="flag_uk.png"
                                   WidthRequest="30"
                                   HeightRequest="20"
                                   Aspect="AspectFill" />
                            <Label Text="English"
                                   FontSize="18"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </RadioButton.Content>
                </RadioButton>

                <!-- Ukrainian -->
                <RadioButton x:Name="UkrainianRadioButton"
                             GroupName="LanguageSelection"
                             CheckedChanged="OnRadioButtonCheckedChanged">
                    <RadioButton.Content>
                        <HorizontalStackLayout Spacing="10">
                            <Image Source="flag_ua.png"
                                   WidthRequest="30"
                                   HeightRequest="20"
                                   Aspect="AspectFill" />
                            <Label Text="Українська"
                                   FontSize="18"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </RadioButton.Content>
                </RadioButton>

                <!-- Polish -->
                <RadioButton x:Name="PolishRadioButton"
                             GroupName="LanguageSelection"
                             CheckedChanged="OnRadioButtonCheckedChanged">
                    <RadioButton.Content>
                        <HorizontalStackLayout Spacing="10">
                            <Image Source="flag_pl.png"
                                   WidthRequest="30"
                                   HeightRequest="20"
                                   Aspect="AspectFill" />
                            <Label Text="Polski"
                                   FontSize="18"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </RadioButton.Content>
                </RadioButton>

                <!-- Russian -->
                <RadioButton x:Name="RussianRadioButton"
                             GroupName="LanguageSelection"
                             CheckedChanged="OnRadioButtonCheckedChanged">
                    <RadioButton.Content>
                        <HorizontalStackLayout Spacing="10">
                            <Image Source="flag_ru.png"
                                   WidthRequest="30"
                                   HeightRequest="20"
                                   Aspect="AspectFill" />
                            <Label Text="Русский"
                                   FontSize="18"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </RadioButton.Content>
                </RadioButton>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
