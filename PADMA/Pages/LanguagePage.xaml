<?xml version="1.0" encoding="utf-8" ?>
<ui:ConfigBasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                   xmlns:ui="clr-namespace:PADMA.UI.Templates;assembly=PADMA"
                   x:Class="PADMA.Pages.LanguagePage"
                   Title="Language">

    <VerticalStackLayout Spacing="15">

        <!-- Заголовок -->
        <Label x:Name="InstructionLabel"
               FontSize="18"
               FontAttributes="Bold"
               TextColor="#222"
               HorizontalOptions="Center"
               Margin="0,10,0,20" />

        <!-- ENGLISH -->
        <Grid ColumnDefinitions="Auto,*,Auto"
              Padding="10"
              x:Name="EnglishRow">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnRowTapped" CommandParameter="ENGLISH" />
            </Grid.GestureRecognizers>

            <RadioButton x:Name="EnglishRadioButton"
                         Grid.Column="0"
                         GroupName="LanguageSelection"
                         CheckedChanged="OnRadioButtonCheckedChanged" />

            <Label Grid.Column="1"
                   FontSize="18"
                   TextColor="#333"
                   VerticalOptions="Center"
                   Text="English"
                   Margin="5,0,0,0" />

            <Frame Grid.Column="2"
                   Padding="1"
                   BorderColor="#888"
                   CornerRadius="2"
                   BackgroundColor="White"
                   HasShadow="False"
                   VerticalOptions="Center">
                <Image Source="flag_uk.png"
                       WidthRequest="30"
                       HeightRequest="20"
                       Aspect="AspectFill" />
            </Frame>
        </Grid>

        <!-- UKRAINIAN -->
        <Grid ColumnDefinitions="Auto,*,Auto"
              Padding="10"
              x:Name="UkrainianRow">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnRowTapped" CommandParameter="UKRAINIAN" />
            </Grid.GestureRecognizers>

            <RadioButton x:Name="UkrainianRadioButton"
                         Grid.Column="0"
                         GroupName="LanguageSelection"
                         CheckedChanged="OnRadioButtonCheckedChanged" />

            <Label Grid.Column="1"
                   FontSize="18"
                   TextColor="#333"
                   VerticalOptions="Center"
                   Text="Українська"
                   Margin="5,0,0,0" />

            <Frame Grid.Column="2"
                   Padding="1"
                   BorderColor="#888"
                   CornerRadius="2"
                   BackgroundColor="White"
                   HasShadow="False"
                   VerticalOptions="Center">
                <Image Source="flag_ua.png"
                       WidthRequest="30"
                       HeightRequest="20"
                       Aspect="AspectFill" />
            </Frame>
        </Grid>

        <!-- POLISH -->
        <Grid ColumnDefinitions="Auto,*,Auto"
              Padding="10"
              x:Name="PolishRow">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnRowTapped" CommandParameter="POLISH" />
            </Grid.GestureRecognizers>

            <RadioButton x:Name="PolishRadioButton"
                         Grid.Column="0"
                         GroupName="LanguageSelection"
                         CheckedChanged="OnRadioButtonCheckedChanged" />

            <Label Grid.Column="1"
                   FontSize="18"
                   TextColor="#333"
                   VerticalOptions="Center"
                   Text="Polski"
                   Margin="5,0,0,0" />

            <Frame Grid.Column="2"
                   Padding="1"
                   BorderColor="#888"
                   CornerRadius="2"
                   BackgroundColor="White"
                   HasShadow="False"
                   VerticalOptions="Center">
                <Image Source="flag_pl.png"
                       WidthRequest="30"
                       HeightRequest="20"
                       Aspect="AspectFill" />
            </Frame>
        </Grid>

        <!-- RUSSIAN -->
        <Grid ColumnDefinitions="Auto,*,Auto"
              Padding="10"
              x:Name="RussianRow">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnRowTapped" CommandParameter="RUSSIAN" />
            </Grid.GestureRecognizers>

            <RadioButton x:Name="RussianRadioButton"
                         Grid.Column="0"
                         GroupName="LanguageSelection"
                         CheckedChanged="OnRadioButtonCheckedChanged" />

            <Label Grid.Column="1"
                   FontSize="18"
                   TextColor="#333"
                   VerticalOptions="Center"
                   Text="Русский"
                   Margin="5,0,0,0" />

            <Frame Grid.Column="2"
                   Padding="1"
                   BorderColor="#888"
                   CornerRadius="2"
                   BackgroundColor="White"
                   HasShadow="False"
                   VerticalOptions="Center">
                <Image Source="flag_ru.png"
                       WidthRequest="30"
                       HeightRequest="20"
                       Aspect="AspectFill" />
            </Frame>
        </Grid>

    </VerticalStackLayout>
</ui:ConfigBasePage>
