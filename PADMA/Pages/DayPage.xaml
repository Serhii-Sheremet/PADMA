<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PADMA.Pages"
    x:Class="PADMA.Pages.DayPage"
    x:Name="DayPageRoot"
    BackgroundColor="#F7FBFF">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="✕" Priority="0" Order="Primary" Clicked="OnCloseClicked" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <ResourceDictionary>

            <DataTemplate x:Key="TooltipTextTemplate">
                <Label FormattedText="{Binding .}"
                       FontSize="13"
                       LineBreakMode="WordWrap" />
            </DataTemplate>

            <DataTemplate x:Key="TooltipDividerTemplate">
                <BoxView HeightRequest="1"
                         Opacity="0.2"
                         BackgroundColor="Black"
                         Margin="0,4,0,4" />
            </DataTemplate>

            <DataTemplate x:Key="TooltipInnerDividerTemplate">
                <Grid Margin="0,4,0,4" ColumnDefinitions="*,3*,*">
                    <BoxView Grid.Column="1"
                             HeightRequest="1"
                             Opacity="0.2"
                             BackgroundColor="Black"
                             HorizontalOptions="Fill" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="TooltipSpacerTemplate">
                <BoxView HeightRequest="{Binding Height}"
                         Opacity="0"
                         Margin="0" />
            </DataTemplate>

            <DataTemplate x:Key="TooltipRangePlainTemplate">
                <Label Text="{Binding Text}"
                       FontSize="12"
                       Opacity="0.85"
                       LineBreakMode="NoWrap"
                       MaxLines="1"
                       Margin="0,0,0,2" />
            </DataTemplate>

            <DataTemplate x:Key="TooltipRangeTemplate">
                <!-- Auto-колонка подстраивается под ширину текста Range -->
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*" Margin="0,0,0,2">
                    <Label Grid.Row="0" Grid.Column="0"
                           Text="{Binding Text}"
                           FontSize="12"
                           Opacity="0.85"
                           LineBreakMode="NoWrap"
                           MaxLines="1" />

                    <!-- Линия рисуется ТОЛЬКО в Auto-колонке => длина = длине текста -->
                    <BoxView Grid.Row="1" Grid.Column="0"
                             HeightRequest="1"
                             Opacity="0.2"
                             BackgroundColor="Black"
                             HorizontalOptions="Fill"
                             Margin="0,2,0,0"/>
                </Grid>
            </DataTemplate>

            <local:TooltipItemTemplateSelector x:Key="TooltipItemTemplateSelector"
                                               TextTemplate="{StaticResource TooltipTextTemplate}"
                                               RangePlainTemplate="{StaticResource TooltipRangePlainTemplate}"
                                               RangeTemplate="{StaticResource TooltipRangeTemplate}"
                                               DividerTemplate="{StaticResource TooltipDividerTemplate}"
                                               InnerDividerTemplate="{StaticResource TooltipInnerDividerTemplate}"
                                               SpacerTemplate="{StaticResource TooltipSpacerTemplate}" />

        </ResourceDictionary>
    </ContentPage.Resources>

    <!--
        Root:
        Row 0 = Header titles (24px)  [fixed]
        Row 1 = Body (vertical scroll) + Sticky overlay [layered]
    -->
    <Grid RowDefinitions="1,24,1,*"
          ColumnDefinitions="Auto,Auto,Auto,*"
          ColumnSpacing="0"
          RowSpacing="0"
          Padding="0"
          BackgroundColor="#F7FBFF">

        <!-- ========================= -->
        <!-- HEADER ROW (titles only) -->
        <!-- ========================= -->

        <!-- Horizontal lines like a table: under Toolbar (top) and under Header (bottom) -->
        <!-- Row 0: top border under toolbar -->
        <BoxView Grid.Row="0" Grid.ColumnSpan="4"
             HeightRequest="1"
             VerticalOptions="Fill"
             Color="{StaticResource TimelineLineColor}"
             Opacity="0.85"/>

        <!-- Row 2: separator between header and body -->
        <BoxView Grid.Row="2" Grid.ColumnSpan="4"
             HeightRequest="1"
             VerticalOptions="Fill"
             Color="{StaticResource TimelineLineColor}"
             Opacity="0.85"/>

        <!-- Column 0: Icons header (empty) -->
        <Grid Grid.Row="1" Grid.Column="0" WidthRequest="24" BackgroundColor="#F7FBFF" />

        <!-- Vertical separator after Icons --><!--
        <BoxView Grid.Row="1" Grid.Column="0"
                 WidthRequest="1"
                 HorizontalOptions="End"
                 VerticalOptions="Fill"
                 Color="Black"
                 Opacity="0.25"/>-->

        <!-- Column 1: Time header (empty) -->
        <Grid Grid.Row="1" Grid.Column="1" WidthRequest="36" BackgroundColor="#F7FBFF" />

        <!-- Vertical separator after Time -->
        <BoxView Grid.Row="1" Grid.Column="1"
                 WidthRequest="1"
                 HorizontalOptions="End"
                 VerticalOptions="Fill"
                 Color="{StaticResource TimelineLineColor}"
                 Opacity="0.85"/>

        <!-- Column 2: Events header -->
        <Grid Grid.Row="1" Grid.Column="2" WidthRequest="80" BackgroundColor="#F7FBFF">
            <Label Text="Events"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   FontAttributes="Bold"
                   Opacity="0.85"
                   FontSize="12"/>
        </Grid>

        <!-- Vertical separator after Events -->
        <BoxView Grid.Row="1" Grid.Column="2"
                 WidthRequest="1"
                 HorizontalOptions="End"
                 VerticalOptions="Fill"
                 Color="{StaticResource TimelineLineColor}"
                 Opacity="0.85"/>

        <!-- Column 3: Transit lanes titles header (horizontally scrollable, synced with body) -->
        <ScrollView x:Name="TransitHeaderScroll"
            Grid.Row="1" Grid.Column="3"
            Orientation="Horizontal"
            HorizontalScrollBarVisibility="Never"
            VerticalScrollBarVisibility="Never"
            Scrolled="OnTransitHeaderScrolled"
            BackgroundColor="#F7FBFF">

            <HorizontalStackLayout Spacing="0"
                           HeightRequest="24"
                           BackgroundColor="#F7FBFF"
                           BindableLayout.ItemsSource="{Binding TransitColumns}">

                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Grid WidthRequest="80"
                              HeightRequest="24"
                              Padding="0"
                              BackgroundColor="#F7FBFF">

                            <Label Text="{Binding Name}"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   FontSize="12"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1"/>

                            <!-- separator -->
                            <BoxView WidthRequest="1"
                                     HorizontalOptions="End"
                                     VerticalOptions="Fill"
                                     Color="{StaticResource TimelineLineColor}"
                                     Opacity="0.85"/>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>

            </HorizontalStackLayout>
        </ScrollView>


        <!-- ========================= -->
        <!-- BODY ROW (layered) -->
        <!--   - Vertical ScrollView (timeline starts at 00:00 right away) -->
        <!--   - Sticky overlay on top (transparent background) -->
        <!-- ========================= -->

        <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4"
              BackgroundColor="#F7FBFF"
              Padding="0">

            <!-- Main vertical scroll (timeline) -->
            <ScrollView x:Name="TimelineScroll"
                        Orientation="Vertical"
                        Scrolled="OnTimelineScrolled"
                        VerticalScrollBarVisibility="Always"
                        BackgroundColor="#F7FBFF">

                <!-- Body grid: Icons | Time | Events | (Transit lanes in horizontal scroll) -->
                <Grid ColumnDefinitions="Auto,Auto,Auto,*"
                      ColumnSpacing="0"
                      RowSpacing="0"
                      Padding="0"
                      BackgroundColor="#F7FBFF">

                    <!-- ICONS column -->
                    <Grid Grid.Column="0" WidthRequest="24" BackgroundColor="#F7FBFF" />
                        <AbsoluteLayout x:Name="IconsBackgroundLayout" BackgroundColor="Transparent" />
                        <AbsoluteLayout x:Name="IconsLayer" BackgroundColor="Transparent"/>

                    <!-- Separator after Icons -->
                    <BoxView Grid.Column="0"
                             WidthRequest="1"
                             HorizontalOptions="End"
                             VerticalOptions="Fill"
                             Color="{StaticResource TimelineLineColor}"
                             Opacity="0.85"/>

                    <!-- TIME SCALE column -->
                    <Grid Grid.Column="1" WidthRequest="36" BackgroundColor="#F7FBFF" >
                        <AbsoluteLayout x:Name="TimeBackgroundLayout" BackgroundColor="Transparent" />
                        <AbsoluteLayout x:Name="TimeScaleLayout" BackgroundColor="Transparent" />
                    </Grid>
    
                    <!-- Separator after Time -->
                    <BoxView Grid.Column="1"
                             WidthRequest="1"
                             HorizontalOptions="End"
                             VerticalOptions="Fill"
                             Color="{StaticResource TimelineLineColor}"
                             Opacity="0.85"/>

                    <!-- USER EVENTS column -->
                    <Grid Grid.Column="2" WidthRequest="80" BackgroundColor="Transparent">

                        <!-- Backgrounds (same idea as TransitBodyGrid) -->
                        <BoxView x:Name="EventsNightBackground"
                                 BackgroundColor="Transparent"
                                 HorizontalOptions="Fill"
                                 VerticalOptions="Fill" />

                        <BoxView x:Name="EventsDayBackground"
                                 BackgroundColor="Transparent"
                                 HorizontalOptions="Fill"
                                 VerticalOptions="Start" />

                        <!-- grid lines -->
                        <AbsoluteLayout x:Name="EventsGridLayout" BackgroundColor="Transparent" />

                        <!-- segments + selection -->
                        <AbsoluteLayout x:Name="EventsBackgroundLayout" BackgroundColor="Transparent">
                            <AbsoluteLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEventsBackgroundTapped" />
                            </AbsoluteLayout.GestureRecognizers>
                        </AbsoluteLayout>

                    </Grid>


                    <!-- Separator after Events -->
                    <BoxView Grid.Column="2"
                             WidthRequest="1"
                             HorizontalOptions="End"
                             VerticalOptions="Fill"
                             Color="{StaticResource TimelineLineColor}"
                             Opacity="0.85"/>

                    <!-- TRANSIT LANES body (horizontal scroll) -->
                    <ScrollView x:Name="TransitBodyScroll"
                                Grid.Row="2" Grid.Column="3"
                                Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never"
                                VerticalScrollBarVisibility="Never"
                                Scrolled="OnTransitBodyScrolled"
                                BackgroundColor="#F7FBFF">

                        <!-- One container that sizes to total width of all columns -->
                        <Grid x:Name="TransitBodyGrid"
                              Padding="0"
                              BackgroundColor="#F7FBFF">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="2880" />
                            </Grid.RowDefinitions>

                            <!-- Backgrounds (keep names for code-behind) -->
                            <BoxView x:Name="TransitNightBackground"
                                     Grid.Row="0"
                                     BackgroundColor="Transparent"
                                     HorizontalOptions="Fill"
                                     VerticalOptions="Fill"/>

                            <BoxView x:Name="TransitDayBackground"
                                     Grid.Row="0"
                                     BackgroundColor="Transparent"
                                     HorizontalOptions="Fill"
                                     VerticalOptions="Start"/>

                            <!-- Dynamic transit columns -->
                            <HorizontalStackLayout x:Name="TransitColumnsHost"
                                Grid.Row="0"
                                Spacing="0"
                                BindableLayout.ItemsSource="{Binding TransitColumns}">

                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid WidthRequest="80"
                                              HeightRequest="2880"
                                              Padding="0"
                                              BackgroundColor="Transparent">

                                            <!-- слой для отрисовки сегментов -->
                                            <AbsoluteLayout InputTransparent="False" />

                                            <!-- separator (right edge) -->
                                            <BoxView WidthRequest="1"
                                                     HorizontalOptions="End"
                                                     VerticalOptions="Fill"
                                                     Color="{StaticResource TimelineLineColor}"
                                                     Opacity="0.85"/>

                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>

                            </HorizontalStackLayout>

                        </Grid>
                    </ScrollView>
                </Grid>
            </ScrollView>

            <!-- Sticky overlay (transparent; does NOT shift 00:00 down) -->
            <Grid x:Name="StickyOverlay"
                  HeightRequest="14"
                  VerticalOptions="Start"
                  HorizontalOptions="Fill"
                  BackgroundColor="Transparent"
                  InputTransparent="True"
                  Padding="0">

                <Grid ColumnDefinitions="24,36,80,*"
                      ColumnSpacing="0"
                      RowSpacing="0"
                      Padding="0"
                      BackgroundColor="Transparent">

                    <Grid Grid.Column="0" WidthRequest="24" BackgroundColor="Transparent" />
                    <Grid Grid.Column="1" WidthRequest="36" BackgroundColor="Transparent" />
                    <Grid Grid.Column="2" WidthRequest="80" BackgroundColor="Transparent" />

                    <!-- Sticky labels for lanes (synced horizontally with header/body) -->
                    <ScrollView x:Name="TransitStickyScroll"
                                Grid.Column="3"
                                Orientation="Horizontal"
                                HorizontalOptions="Fill"
                                HorizontalScrollBarVisibility="Never"
                                VerticalScrollBarVisibility="Never"
                                Scrolled="OnTransitStickyScrolled"
                                BackgroundColor="Transparent">

                        <HorizontalStackLayout Spacing="0"
                                   HeightRequest="14"
                                   BackgroundColor="Transparent"
                                   BindableLayout.ItemsSource="{Binding TransitColumns}">

                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid WidthRequest="80"
                                          HeightRequest="14"
                                          Padding="0"
                                          BackgroundColor="Transparent">

                                        <Label WidthRequest="80"
                                               Text="{Binding StickyText}"
                                               TextColor="Black"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               Opacity="0.75"
                                               HorizontalOptions="Fill"
                                               VerticalOptions="Fill"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1"/>

                                        <BoxView WidthRequest="1"
                                                 HorizontalOptions="End"
                                                 VerticalOptions="Fill"
                                                 Color="{StaticResource TimelineLineColor}"
                                                 Opacity="0.85"/>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>

                        </HorizontalStackLayout>
                    </ScrollView>
                </Grid>
            </Grid>

        </Grid>

        <!-- Tooltip Overlay -->
        <Grid x:Name="TooltipOverlay"
              IsVisible="{Binding IsTooltipVisible}"
              InputTransparent="{Binding IsTooltipHiddenInputTransparent}"
              Grid.RowSpan="4"
              Grid.ColumnSpan="4">

            <!-- backdrop catches tap -->
            <BoxView BackgroundColor="#80000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTooltipBackdropTapped"/>
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- panel is above backdrop, no close-tap here -->
            <Frame Padding="12"
                   CornerRadius="12"
                   HasShadow="True"
                   BackgroundColor="White"
                   Margin="18"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   MaximumHeightRequest="{Binding Source={x:Reference DayPageRoot}, Path=TooltipMaxHeight}"
                   MaximumWidthRequest="{Binding Source={x:Reference DayPageRoot}, Path=TooltipMaxWidth}">

                <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                      RowSpacing="6">

                    <!-- Title -->
                    <Label Grid.Row="0"
                           Text="{Binding TooltipTitle}"
                           IsVisible="{Binding HasTooltipHeader}"
                           FontAttributes="Bold"
                           FontSize="14"
                           LineBreakMode="WordWrap" />

                    <!-- Range -->
                    <Label Grid.Row="1"
                           Text="{Binding TooltipRange}"
                           IsVisible="{Binding HasTooltipHeader}"
                           FontSize="12"
                           Opacity="0.85"
                           LineBreakMode="WordWrap"
                           Margin="0,0,0,4" />

                    <!-- Divider -->
                    <BoxView Grid.Row="2"
                             IsVisible="{Binding HasTooltipHeaderAndBlocks}"
                             HeightRequest="1"
                             Opacity="0.2"
                             BackgroundColor="Black"
                             Margin="0,0,0,2" />

                    <!-- Body (0..N blocks) -->
                    <ScrollView Grid.Row="3"
                                IsVisible="{Binding HasTooltipBlocks}"
                                VerticalOptions="Start"
                                HeightRequest="{Binding Source={x:Reference DayPageRoot}, Path=TooltipBodyHeight}"
                                VerticalScrollBarVisibility="Never">
                        <VerticalStackLayout x:Name="TooltipBodyStack"
                                             Spacing="6"
                                             BindableLayout.ItemsSource="{Binding TooltipItems}"
                                             BindableLayout.ItemTemplateSelector="{StaticResource TooltipItemTemplateSelector}" />
                    </ScrollView>

                </Grid>
            </Frame>
        </Grid>

        <!-- User Event Editor Overlay (Appointments) -->
        <Grid x:Name="UserEventOverlay"
              IsVisible="False"
              InputTransparent="False"
              Grid.RowSpan="4"
              Grid.ColumnSpan="4"
              BackgroundColor="Transparent">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnUserEventOverlayTapped" />
            </Grid.GestureRecognizers>

            <!-- Backdrop: blocks taps, does NOT close -->
            <BoxView BackgroundColor="#80000000" >
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnUserEventOverlayTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Editor card -->
            <Border x:Name="UserEventCard"
                    BackgroundColor="White"
                    StrokeThickness="1"
                    Stroke="#22000000"
                    Padding="12"
                    Margin="18"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    MaximumWidthRequest="420">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>

                <!-- ВАЖНО: пустой TapGesture, чтобы не пробрасывать на overlay -->
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <!-- контент: Header, TimePickers, Title, Message, ColorPalette, Buttons -->
                <Grid RowDefinitions="Auto,Auto,Auto"
                      RowSpacing="10">

                    <!-- Header -->
                    <Label Grid.Row="0"
                           x:Name="UserEventHeader"
                           FontAttributes="Bold"
                           FontSize="14" />

                    <!-- Time + Title + Description (small) -->
                    <VerticalStackLayout Grid.Row="1" Spacing="8">

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <TimePicker x:Name="StartTimePicker" Grid.Column="0" />
                            <TimePicker x:Name="EndTimePicker" Grid.Column="1" />
                        </Grid>

                        <Entry x:Name="TitleEntry" Placeholder="Title" />

                        <!-- 3–4 lines area -->
                        <Editor x:Name="MessageEditor"
                                Placeholder="Description"
                                AutoSize="TextChanges"
                                HeightRequest="96" />
                    </VerticalStackLayout>

                    <!-- Bottom fixed: palette + buttons -->
                    <VerticalStackLayout Grid.Row="2" Spacing="10">

                        <HorizontalStackLayout x:Name="ColorPalette" Spacing="10" />

                        <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                              ColumnSpacing="10">

                            <Button x:Name="DeleteButton"
                                    Grid.Column="0"
                                    Text="Delete"
                                    Clicked="OnUserEventDelete" />

                            <BoxView Grid.Column="1" Opacity="0" />

                            <Button Grid.Column="2"
                                    Text="Cancel"
                                    Clicked="OnUserEventCancel" />

                            <Button Grid.Column="3"
                                    Text="OK"
                                    Clicked="OnUserEventOk" />
                        </Grid>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>



    </Grid>
</ContentPage>
