<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PADMA.Pages.DayPage"
    BackgroundColor="#F7FBFF">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="✕" Priority="0" Order="Primary" Clicked="OnCloseClicked" />
    </ContentPage.ToolbarItems>

    <!--
        Root:
        Row 0 = Header titles (24px)  [fixed]
        Row 1 = Body (vertical scroll) + Sticky overlay [layered]
    -->
    <Grid RowDefinitions="1,24,1,*"
          ColumnDefinitions="Auto,Auto,Auto,*"
          ColumnSpacing="0"
          RowSpacing="0"
          Padding="0"
          BackgroundColor="#F7FBFF">

        <!-- ========================= -->
        <!-- HEADER ROW (titles only) -->
        <!-- ========================= -->

        <!-- Horizontal lines like a table: under Toolbar (top) and under Header (bottom) -->
        <!-- Row 0: top border under toolbar -->
        <BoxView Grid.Row="0" Grid.ColumnSpan="4"
             HeightRequest="1"
             VerticalOptions="Fill"
             Color="{StaticResource TimelineLineColor}"
             Opacity="0.85"/>

        <!-- Row 2: separator between header and body -->
        <BoxView Grid.Row="2" Grid.ColumnSpan="4"
             HeightRequest="1"
             VerticalOptions="Fill"
             Color="{StaticResource TimelineLineColor}"
             Opacity="0.85"/>

        <!-- Column 0: Icons header (empty) -->
        <Grid Grid.Row="1" Grid.Column="0" WidthRequest="24" BackgroundColor="#F7FBFF" />

        <!-- Vertical separator after Icons --><!--
        <BoxView Grid.Row="1" Grid.Column="0"
                 WidthRequest="1"
                 HorizontalOptions="End"
                 VerticalOptions="Fill"
                 Color="Black"
                 Opacity="0.25"/>-->

        <!-- Column 1: Time header (empty) -->
        <Grid Grid.Row="1" Grid.Column="1" WidthRequest="36" BackgroundColor="#F7FBFF" />

        <!-- Vertical separator after Time -->
        <BoxView Grid.Row="1" Grid.Column="1"
                 WidthRequest="1"
                 HorizontalOptions="End"
                 VerticalOptions="Fill"
                 Color="{StaticResource TimelineLineColor}"
                 Opacity="0.85"/>

        <!-- Column 2: Events header -->
        <Grid Grid.Row="1" Grid.Column="2" WidthRequest="80" BackgroundColor="#F7FBFF">
            <Label Text="Events"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   FontAttributes="Bold"
                   Opacity="0.85"
                   FontSize="12"/>
        </Grid>

        <!-- Vertical separator after Events -->
        <BoxView Grid.Row="1" Grid.Column="2"
                 WidthRequest="1"
                 HorizontalOptions="End"
                 VerticalOptions="Fill"
                 Color="{StaticResource TimelineLineColor}"
                 Opacity="0.85"/>

        <!-- Column 3: Transit lanes titles header (horizontally scrollable, synced with body) -->
        <ScrollView x:Name="TransitHeaderScroll"
            Grid.Row="1" Grid.Column="3"
            Orientation="Horizontal"
            HorizontalScrollBarVisibility="Never"
            VerticalScrollBarVisibility="Never"
            Scrolled="OnTransitHeaderScrolled"
            BackgroundColor="#F7FBFF">

            <HorizontalStackLayout Spacing="0"
                           HeightRequest="24"
                           BackgroundColor="#F7FBFF"
                           BindableLayout.ItemsSource="{Binding TransitColumns}">

                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Grid WidthRequest="80"
                              HeightRequest="24"
                              Padding="0"
                              BackgroundColor="#F7FBFF">

                            <Label Text="{Binding Name}"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   FontSize="12"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1"/>

                            <!-- separator -->
                            <BoxView WidthRequest="1"
                                     HorizontalOptions="End"
                                     VerticalOptions="Fill"
                                     Color="{StaticResource TimelineLineColor}"
                                     Opacity="0.85"/>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>

            </HorizontalStackLayout>
        </ScrollView>


        <!-- ========================= -->
        <!-- BODY ROW (layered) -->
        <!--   - Vertical ScrollView (timeline starts at 00:00 right away) -->
        <!--   - Sticky overlay on top (transparent background) -->
        <!-- ========================= -->

        <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4"
              BackgroundColor="#F7FBFF"
              Padding="0">

            <!-- Main vertical scroll (timeline) -->
            <ScrollView x:Name="TimelineScroll"
                        Orientation="Vertical"
                        Scrolled="OnTimelineScrolled"
                        VerticalScrollBarVisibility="Always"
                        BackgroundColor="#F7FBFF">

                <!-- Body grid: Icons | Time | Events | (Transit lanes in horizontal scroll) -->
                <Grid ColumnDefinitions="Auto,Auto,Auto,*"
                      ColumnSpacing="0"
                      RowSpacing="0"
                      Padding="0"
                      BackgroundColor="#F7FBFF">

                    <!-- ICONS column -->
                    <Grid Grid.Column="0" WidthRequest="24" BackgroundColor="#F7FBFF" />

                    <!-- Separator after Icons -->
                    <BoxView Grid.Column="0"
                             WidthRequest="1"
                             HorizontalOptions="End"
                             VerticalOptions="Fill"
                             Color="{StaticResource TimelineLineColor}"
                             Opacity="0.85"/>

                    <!-- TIME SCALE column -->
                    <Grid Grid.Column="1" WidthRequest="36" BackgroundColor="#F7FBFF" >
                        <AbsoluteLayout x:Name="TimeBackgroundLayout" BackgroundColor="Transparent" />
                        <AbsoluteLayout x:Name="TimeScaleLayout" BackgroundColor="Transparent" />
                    </Grid>
    
                    <!-- Separator after Time -->
                    <BoxView Grid.Column="1"
                             WidthRequest="1"
                             HorizontalOptions="End"
                             VerticalOptions="Fill"
                             Color="{StaticResource TimelineLineColor}"
                             Opacity="0.85"/>

                    <!-- USER EVENTS column -->
                    <Grid Grid.Column="2" WidthRequest="80" BackgroundColor="#F7FBFF" >
                        <AbsoluteLayout x:Name="EventsBackgroundLayout" BackgroundColor="Transparent" />
                        <AbsoluteLayout x:Name="EventsGridLayout" BackgroundColor="Transparent" />
                    </Grid>

                <!-- Separator after Events -->
                    <BoxView Grid.Column="2"
                             WidthRequest="1"
                             HorizontalOptions="End"
                             VerticalOptions="Fill"
                             Color="{StaticResource TimelineLineColor}"
                             Opacity="0.85"/>

                    <!-- TRANSIT LANES body (horizontal scroll) -->
                    <ScrollView x:Name="TransitBodyScroll"
                                Grid.Row="2" Grid.Column="3"
                                Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never"
                                VerticalScrollBarVisibility="Never"
                                Scrolled="OnTransitBodyScrolled"
                                BackgroundColor="#F7FBFF">

                        <!-- One container that sizes to total width of all columns -->
                        <Grid x:Name="TransitBodyGrid"
                              Padding="0"
                              BackgroundColor="#F7FBFF">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="2880" />
                            </Grid.RowDefinitions>

                            <!-- Backgrounds (keep names for code-behind) -->
                            <BoxView x:Name="TransitNightBackground"
                                     Grid.Row="0"
                                     BackgroundColor="Transparent"
                                     HorizontalOptions="Fill"
                                     VerticalOptions="Fill"/>

                            <BoxView x:Name="TransitDayBackground"
                                     Grid.Row="0"
                                     BackgroundColor="Transparent"
                                     HorizontalOptions="Fill"
                                     VerticalOptions="Start"/>

                            <!-- Dynamic transit columns -->
                            <HorizontalStackLayout x:Name="TransitColumnsHost"
                                Grid.Row="0"
                                Spacing="0"
                                BindableLayout.ItemsSource="{Binding TransitColumns}">

                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid WidthRequest="80"
                                              HeightRequest="2880"
                                              Padding="0"
                                              BackgroundColor="Transparent">

                                            <!-- слой для отрисовки сегментов -->
                                            <AbsoluteLayout InputTransparent="True" />

                                            <!-- separator (right edge) -->
                                            <BoxView WidthRequest="1"
                                                     HorizontalOptions="End"
                                                     VerticalOptions="Fill"
                                                     Color="{StaticResource TimelineLineColor}"
                                                     Opacity="0.85"/>

                                            <!-- пока пусто: сюда позже положим реальные блоки/транзиты -->
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>

                            </HorizontalStackLayout>

                        </Grid>
                    </ScrollView>
                </Grid>
            </ScrollView>

            <!-- Sticky overlay (transparent; does NOT shift 00:00 down) -->
            <Grid x:Name="StickyOverlay"
                  HeightRequest="20"
                  VerticalOptions="Start"
                  HorizontalOptions="Fill"
                  BackgroundColor="Transparent"
                  InputTransparent="True"
                  Padding="0">

                <!-- Keep left 3 columns aligned, sticky only for transit lanes -->
                <Grid ColumnDefinitions="Auto,Auto,Auto,*"
                      ColumnSpacing="0"
                      RowSpacing="0"
                      Padding="0"
                      BackgroundColor="Transparent">

                    <Grid Grid.Column="0" WidthRequest="20" BackgroundColor="Transparent" />
                    <Grid Grid.Column="1" WidthRequest="40" BackgroundColor="Transparent" />
                    <Grid Grid.Column="2" WidthRequest="80" BackgroundColor="Transparent" />
                    <Grid Grid.Column="3" WidthRequest="80" BackgroundColor="Transparent" />

                    <!-- Sticky labels for lanes (synced horizontally with header/body) -->
                    <ScrollView x:Name="TransitStickyScroll"
                                Grid.Column="3"
                                Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never"
                                VerticalScrollBarVisibility="Never"
                                Scrolled="OnTransitStickyScrolled"
                                BackgroundColor="Transparent">

                        <HorizontalStackLayout Spacing="0"
                            HeightRequest="20"
                            BackgroundColor="Transparent"
                            BindableLayout.ItemsSource="{Binding TransitColumns}">

                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid WidthRequest="80"
                                          HeightRequest="20"
                                          Padding="0"
                                          BackgroundColor="Transparent">

                                        <!-- пока тест: можно оставить пустым или поставить (sticky) -->
                                        <!-- позже сюда будет подставляться текущее значение транзита -->
                                        <Label Text="{Binding StickyText}"
                                               TextColor="Black"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               Opacity="0.85"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"/>

                                        <!-- separator -->
                                        <BoxView WidthRequest="1"
                                                 HorizontalOptions="End"
                                                 VerticalOptions="Fill"
                                                 Color="{StaticResource TimelineLineColor}"
                                                 Opacity="0.85"/>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>

                        </HorizontalStackLayout>
                    </ScrollView>

                </Grid>
            </Grid>

        </Grid>

    </Grid>
</ContentPage>
