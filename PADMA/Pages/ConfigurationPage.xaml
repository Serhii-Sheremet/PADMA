<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PADMA.Pages.ConfigurationPage"
             Title="Настройки">

    <VerticalStackLayout Padding="20" Spacing="20">
        <Label Text="Первый день недели:" FontAttributes="Bold" />

        <RadioButton Content="Понедельник"
                     GroupName="FirstDayOfWeek"
                     IsChecked="{Binding IsMondayFirst}" 
                     CheckedChanged="OnFirstDayOfWeekChanged"/>

        <RadioButton Content="Воскресенье"
                     GroupName="FirstDayOfWeek"
                     IsChecked="{Binding IsSundayFirst}" 
                     CheckedChanged="OnFirstDayOfWeekChanged"/>
    </VerticalStackLayout>
</ContentPage>
