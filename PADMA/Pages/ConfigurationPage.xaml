<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PADMA.Pages.ConfigurationPage"
             Title="Configuration">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="✖" Priority="0" Order="Primary" Clicked="OnCloseClicked"/>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Button Text="Language"
                    Clicked="OnLanguageClicked"/>
            <Button Text="First day of week"
                    Clicked="OnFirstDayOfWeekClicked"/>
            <Button Text="Planetary transits"
                    Clicked="OnTransitsClicked"/>
            <Button Text="Nodes (Rahu and Ketu)"
                    Clicked="OnNodesClicked"/>
            <Button Text="Hora"
                    Clicked="OnHoraClicked"/>
            <Button Text="30 Muhurtas (60 Ghatis)"
                    Clicked="OnMuhurtasClicked"/>
            <Button Text="Mrityu Bhaga"
                    Clicked="OnMrityuBhagaClicked"/>
            <Button Text="Sunrise calculation"
                    Clicked="OnSunriseClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
