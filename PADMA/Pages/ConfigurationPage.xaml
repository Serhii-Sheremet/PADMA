<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PADMA.Pages.ConfigurationPage"
             Title="Settings">

    <VerticalStackLayout Padding="20" Spacing="20">

        <Label Text="First day of week:" 
               FontAttributes="Bold"
               FontSize="16"/>

        <RadioButton x:Name="MondayRadio"
                     Content="Monday"
                     GroupName="WeekStart"
                     CheckedChanged="OnOptionChanged"/>

        <RadioButton x:Name="SundayRadio"
                     Content="Sunday"
                     GroupName="WeekStart"
                     CheckedChanged="OnOptionChanged"/>

        <!-- Apply button -->
        <Button Text="Apply Changes"
                Clicked="OnApplyClicked"
                HorizontalOptions="Center"/>
    </VerticalStackLayout>

    <!-- Крестик -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="✖" 
                     Priority="0"
                     Order="Primary"
                     Clicked="OnCloseClicked"/>
    </ContentPage.ToolbarItems>
</ContentPage>
