<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PADMA.Pages.ConfigurationPage"
             Title="Configuration">

    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="close_icon.png"
                     Priority="0"
                     Order="Primary"
                     Clicked="OnCloseClicked" />
    </ContentPage.ToolbarItems>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="15">

                <Button x:Name="btnLanguage"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        Text="Language"
                        Clicked="OnLanguageClicked" />

                <Button x:Name="btnFirstDayOfWeek"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        Text="First day of week"
                        Clicked="OnFirstDayOfWeekClicked" />

                <Button x:Name="btnTransits"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        Text="Planetary transits"
                        Clicked="OnTransitsClicked" />

                <Button x:Name="btnNodes"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        Text="Nodes (Rahu and Ketu)"
                        Clicked="OnNodesClicked" />

                <Button x:Name="btnHora"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        Text="Hora"
                        Clicked="OnHoraClicked" />

                <Button x:Name="btnMuhurta"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        Text="30 Muhurtas (60 Ghatis)"
                        Clicked="OnMuhurtasClicked" />

                <Button x:Name="btnMrityuBhaga"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        Text="Mrityu Bhaga"
                        Clicked="OnMrityuBhagaClicked" />

                <Button x:Name="btnSunrise"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        Text="Sunrise calculation"
                        Clicked="OnSunriseClicked" />

                <Button x:Name="btnColorSettings"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        Text="Color settings"
                        Clicked="OnColorSettingsClicked" />

                <Button x:Name="btnNotifications"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        Text="Notifications"
                        Clicked="OnNotificationsClicked" />

                <Button x:Name="btnRetention"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        Text="Retention policy"
                        Clicked="OnRetentionClicked" />

            </VerticalStackLayout>
        </ScrollView>

        <!--  Busy overlay -->
        <Grid
            IsVisible="{Binding IsBusy, FallbackValue=False}"
            InputTransparent="False"
            BackgroundColor="#80000000"
            ZIndex="999">

            <VerticalStackLayout
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="12">

                <ActivityIndicator
                    IsRunning="True"
                    WidthRequest="48"
                    HeightRequest="48" />

                <Label
                    Text="{Binding BusyText}"
                    TextColor="White"
                    FontSize="Medium"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
