<?xml version="1.0" encoding="utf-8" ?>
<ui:ConfigBasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ui="clr-namespace:PADMA.UI.Templates;assembly=PADMA"
    x:Class="PADMA.Pages.FirstDayOfWeekPage"
    Title="Day of week">

    <VerticalStackLayout Padding="20" Spacing="20">
        <!-- Заголовок страницы -->
        <Label x:Name="PageTitle"
               FontSize="20"
               HorizontalOptions="Center"
               TextColor="Black"/>

        <!-- Радио-кнопки -->
        <RadioButton x:Name="MondayRadioButton"
                     GroupName="WeekStart"
                     CheckedChanged="OnRadioButtonCheckedChanged"/>

        <RadioButton x:Name="SundayRadioButton"
                     GroupName="WeekStart"
                     CheckedChanged="OnRadioButtonCheckedChanged"/>
    </VerticalStackLayout>

    <!-- Крестик для закрытия -->
    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="close_icon.png"
                 Order="Primary"
                 Priority="0"
                 Clicked="OnCloseClicked" />
    </ContentPage.ToolbarItems>
</ui:ConfigBasePage>
