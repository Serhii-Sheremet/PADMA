<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PADMA.Pages.ProfilesPage"
    Title="Profiles">

    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="close_icon.png"
                 Priority="0"
                 Order="Primary"
                 Clicked="OnCloseClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="12"
          RowSpacing="10">

        <!-- ADD NEW PROFILE -->
        <Button
            Grid.Row="0"
            x:Name="btnAddProfile"
            Text="Add new profile"
            Clicked="OnAddProfileClicked"
            FontSize="16"
            HeightRequest="48" />

        <!-- PROFILES LIST -->
        <CollectionView
            Grid.Row="1"
            x:Name="profilesView"
            ItemsSource="{Binding Profiles}"
            SelectionMode="Single"
            SelectionChanged="OnProfileSelected">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame
                        Padding="10"
                        Margin="0,4"
                        CornerRadius="10"
                        HasShadow="False"
                        BorderColor="#C8C8C8"
                        InputTransparent="True">

                        <!-- Visual states for selection highlight -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                        <Setter Property="BorderColor" Value="#C8C8C8" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#1A000000" />
                                        <Setter Property="BorderColor" Value="#666666" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- star (left) + name (right) -->
                        <Grid ColumnDefinitions="26,*"
                              ColumnSpacing="10"
                              VerticalOptions="Center">

                            <!-- Default marker on the LEFT -->
                            <Image Source="star_shine.png"
                                   HeightRequest="20"
                                   WidthRequest="20"
                                   Grid.Column="0"
                                   IsVisible="{Binding IsDefault}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding ProfileName}"
                                FontSize="15"
                                VerticalOptions="Center" />

                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ACTIONS PANEL -->
        <Grid
            Grid.Row="2"
            x:Name="actionsPanel"
            IsVisible="False"
            ColumnSpacing="8"
            ColumnDefinitions="*,2*,Auto">

            <Button
                Grid.Column="0"
                x:Name="btnDetails"
                Text="Details"
                FontSize="12"
                Clicked="OnDetailsClicked" />

            <Button
                Grid.Column="1"
                x:Name="btnSetDefault"
                Text="Set default"
                FontSize="12"
                Clicked="OnSetDefaultClicked" />

            <Button
                Grid.Column="2"
                x:Name="btnChoose"
                Text="Choose"
                FontSize="12"
                Clicked="OnChooseClicked" />
        </Grid>

    </Grid>
</ContentPage>
