<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:PADMA.Pages"
             x:Class="PADMA.Pages.MonthlyPlanetTransitsPage"
             x:Name="RootPage">

    <ContentPage.Resources>

        <DataTemplate x:Key="MonthlyTooltipHeaderTemplate">
            <Label Text="{Binding Text}"
               FontAttributes="Bold"
               FontSize="13"
               TextColor="Black"
               LineBreakMode="WordWrap" />
        </DataTemplate>

        <DataTemplate x:Key="MonthlyTooltipLineTemplate">
            <Label FontSize="12"
               TextColor="Black"
               LineBreakMode="WordWrap">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding Label}"
                          TextDecorations="Underline" />
                        <Span Text=": " />
                        <Span Text="{Binding Value}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </DataTemplate>

        <DataTemplate x:Key="MonthlyTooltipRangeTemplate">
            <Label Text="{Binding Text}"
               FontSize="12"
               TextColor="#666666"
               LineBreakMode="WordWrap" />
        </DataTemplate>

        <DataTemplate x:Key="MonthlyTooltipShortDividerTemplate">
            <BoxView HeightRequest="1"
                 WidthRequest="160"
                 HorizontalOptions="Start"
                 BackgroundColor="#DDDDDD"
                 Margin="0,2,0,2" />
        </DataTemplate>

        <DataTemplate x:Key="MonthlyTooltipDividerTemplate">
            <BoxView HeightRequest="1"
                 HorizontalOptions="Fill"
                 BackgroundColor="#DDDDDD"
                 Margin="0,4,0,4" />
        </DataTemplate>

        <DataTemplate x:Key="MonthlyTooltipSpacerTemplate">
            <BoxView HeightRequest="{Binding Height}"
                 Opacity="0" />
        </DataTemplate>

        <DataTemplate x:Key="MonthlyTooltipTwoLineRangeTemplate">
            <VerticalStackLayout Spacing="1">
                <Label FontSize="12"
                       TextColor="Black"
                       LineBreakMode="WordWrap">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Label}"
                                  TextDecorations="Underline" />
                            <Span Text=":" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Label FontSize="12"
                       TextColor="#555555"
                       LineBreakMode="WordWrap">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Value}"
                                  TextDecorations="Underline" />
                            <Span Text=": " />
                            <Span Text="{Binding RangeText}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>
        </DataTemplate>

        <DataTemplate x:Key="MonthlyTooltipSimpleRangeLineTemplate">
            <Label FontSize="12"
                   TextColor="#555555"
                   LineBreakMode="WordWrap">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding Label}"
                              TextDecorations="Underline" />
                        <Span Text=": " />
                        <Span Text="{Binding RangeText}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </DataTemplate>

        <pages:MonthlyTooltipItemTemplateSelector
                x:Key="MonthlyTooltipItemTemplateSelector"
                HeaderTemplate="{StaticResource MonthlyTooltipHeaderTemplate}"
                LineTemplate="{StaticResource MonthlyTooltipLineTemplate}"
                TwoLineRangeTemplate="{StaticResource MonthlyTooltipTwoLineRangeTemplate}"
                SimpleRangeLineTemplate="{StaticResource MonthlyTooltipSimpleRangeLineTemplate}"
                DividerTemplate="{StaticResource MonthlyTooltipDividerTemplate}"
                SpacerTemplate="{StaticResource MonthlyTooltipSpacerTemplate}" />

    </ContentPage.Resources>

    <Shell.TitleView>
        <Grid Padding="0" VerticalOptions="Center">
            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                <Label Text="{Binding MonthYearTitle}"
                       FontAttributes="Bold"
                       FontSize="20"
                       VerticalOptions="Center" />
                <Label Text="▼" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMonthTitleTapped" />
            </Grid.GestureRecognizers>
        </Grid>
    </Shell.TitleView>

    <Grid Padding="0" RowSpacing="0" ColumnSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Active profile row -->
        <Grid Grid.Row="0"
              Padding="8,2"
              ColumnSpacing="8"
              ColumnDefinitions="*,Auto"
              Opacity="0.85">

            <Label Grid.Column="0"
                   Text="{Binding ActiveProfileDisplay}"
                   FontSize="14"
                   LineBreakMode="TailTruncation"
                   VerticalOptions="Center" />

            <Label Grid.Column="1"
                   Text="{Binding ActiveLocationTimeZoneDisplay}"
                   FontSize="14"
                   LineBreakMode="TailTruncation"
                   HorizontalTextAlignment="End"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Monthly transits row -->
        <Grid Grid.Row="1"
              BackgroundColor="White"
              RowSpacing="0"
              ColumnSpacing="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- top-left corner -->
            <Border Grid.Row="0"
                    Grid.Column="0"
                    Stroke="#D0D0D0"
                    StrokeThickness="1"
                    BackgroundColor="#F7F7F7" />

            <!-- day header -->
            <ScrollView x:Name="HeaderHorizontalScroll"
                Grid.Row="0"
                Grid.Column="1"
                Orientation="Horizontal"
                HorizontalScrollBarVisibility="Never"
                VerticalScrollBarVisibility="Never"
                Scrolled="OnHeaderHorizontalScrolled">

                <GraphicsView x:Name="HeaderGraphicsView"
                      HeightRequest="44" />
            </ScrollView>

            <!-- fixed left labels -->
            <ScrollView x:Name="LabelsVerticalScroll"
                Grid.Row="1"
                Grid.Column="0"
                Orientation="Vertical"
                HorizontalScrollBarVisibility="Never"
                VerticalScrollBarVisibility="Never"
                Scrolled="OnLabelsVerticalScrolled">

                <GraphicsView x:Name="LabelsGraphicsView"
                      WidthRequest="96" />
            </ScrollView>

            <!-- body -->
            <ScrollView x:Name="BodyHorizontalScroll"
                Grid.Row="1"
                Grid.Column="1"
                Orientation="Horizontal"
                HorizontalScrollBarVisibility="Always"
                VerticalScrollBarVisibility="Never"
                Scrolled="OnBodyHorizontalScrolled">

                <ScrollView x:Name="BodyVerticalScroll"
                    Orientation="Vertical"
                    HorizontalScrollBarVisibility="Never"
                    VerticalScrollBarVisibility="Always"
                    Scrolled="OnBodyVerticalScrolled">

                    <GraphicsView x:Name="BodyGraphicsView">
                        <GraphicsView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBodyGraphicsTapped" />
                        </GraphicsView.GestureRecognizers>
                    </GraphicsView>
                </ScrollView>
            </ScrollView>
        </Grid>

        <!-- Structural separator between day header and timeline body -->
        <BoxView Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HeightRequest="1"
            VerticalOptions="Start"
            HorizontalOptions="Fill"
            Color="#D0D0D0"
            InputTransparent="True" />

        <Grid x:Name="TooltipOverlay"
              IsVisible="{Binding IsTooltipVisible, Source={x:Reference RootPage}}"
              Grid.RowSpan="2"
              ZIndex="900">

            <BoxView BackgroundColor="#80000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTooltipBackdropTapped"/>
                </BoxView.GestureRecognizers>
            </BoxView>

            <Frame Padding="12"
                   CornerRadius="12"
                   HasShadow="True"
                   BackgroundColor="White"
                   Margin="18"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HeightRequest="{Binding TooltipHeight, Source={x:Reference RootPage}}"
                   MaximumWidthRequest="{Binding TooltipMaxWidth, Source={x:Reference RootPage}}">

                <Grid RowDefinitions="Auto,Auto,*"
                      RowSpacing="6">

                    <Label Grid.Row="0"
                           Text="{Binding TooltipTitle, Source={x:Reference RootPage}}"
                           FontAttributes="Bold"
                           FontSize="14"
                           TextColor="Black"
                           LineBreakMode="WordWrap" />

                    <BoxView Grid.Row="1"
                             HeightRequest="1"
                             Opacity="0.2"
                             BackgroundColor="Black"
                             Margin="0,0,0,2" />

                    <ScrollView Grid.Row="2"
                           HeightRequest="{Binding TooltipBodyHeight, Source={x:Reference RootPage}}"
                           VerticalScrollBarVisibility="Default">

                        <VerticalStackLayout Spacing="6"
                                     BindableLayout.ItemsSource="{Binding TooltipItems, Source={x:Reference RootPage}}"
                                     BindableLayout.ItemTemplateSelector="{StaticResource MonthlyTooltipItemTemplateSelector}" />
                    </ScrollView>
                </Grid>
            </Frame>
        </Grid>

        <!--  Busy overlay -->
        <Grid Grid.Row="1"
              Grid.ColumnSpan="2"
              IsVisible="{Binding IsBusy, Source={x:Reference RootPage}, FallbackValue=False}"
              InputTransparent="False"
              BackgroundColor="#80000000"
              ZIndex="999">

            <VerticalStackLayout
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="12">

                <ActivityIndicator
                    IsRunning="True"
                    WidthRequest="48"
                    HeightRequest="48" />

                <Label Text="{Binding BusyText, Source={x:Reference RootPage}}"
                       TextColor="White"
                       FontSize="Medium"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
