<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:PADMA.UI;assembly=PADMA"
             x:Class="PADMA.Pages.MainPage"
             xmlns:controls="clr-namespace:Plugin.Maui.Calendar.Controls;assembly=Plugin.Maui.Calendar"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">

    <Shell.TitleView>
        <Grid Padding="0" VerticalOptions="Center">
            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                <Label Text="{Binding MonthYearTitle}"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />
                <Label Text="▼" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMonthTitleTapped" />
            </Grid.GestureRecognizers>
        </Grid>
    </Shell.TitleView>

    <Grid Padding="0" RowSpacing="0" ColumnSpacing="0">
        
        <Grid.RowDefinitions>
            <!-- Row with active profile -->
            <RowDefinition Height="Auto" />
            <!-- Row for the headings of the days of the week -->
            <RowDefinition Height="Auto" />
            <!-- Main calendar -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Active profile row -->
        <Grid Grid.Row="0"
          Padding="8,2"
          ColumnSpacing="8"
          ColumnDefinitions="*,Auto"
          Opacity="0.85">

            <Label Grid.Column="0"
               Text="{Binding ActiveProfileDisplay}"
               FontSize="14"
               LineBreakMode="TailTruncation"
               VerticalOptions="Center" />

            <Label Grid.Column="1"
               Text="{Binding ActiveLocationTimeZoneDisplay}"
               FontSize="14"
               LineBreakMode="TailTruncation"
               HorizontalTextAlignment="End"
               VerticalOptions="Center" />
        </Grid>

        <!-- Headings with day abbreviations -->
        <Grid x:Name="DaysHeaderGrid"
              Grid.Row="1"
              HeightRequest="24"
              Margin="0"
              ColumnSpacing="0"
              RowSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        </Grid>

        <!-- Calendar -->
        <CollectionView x:Name="CalendarCollection"
                        Grid.Row="2"
                        ItemsSource="{Binding Days}"
                        SelectionMode="Single"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand"
                        BackgroundColor="White"
                        SelectionChanged="OnSelectionChanged">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="7"
                                 HorizontalItemSpacing="0"
                                 VerticalItemSpacing="0" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="ui:DayItem">
                    <Border
                        HeightRequest="{Binding Source={x:Reference CalendarCollection},
                                                 Path=Height,
                                                 Converter={StaticResource HeightToCellHeightConverter}}"
                        Stroke="Black"
                        StrokeThickness="0.5"
                        Padding="0"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand">

                        <Border.Background>
                            <MultiBinding Converter="{StaticResource DayCellBackgroundConverter}">
                                <Binding Path="IsToday" />
                                <Binding Path="Date" />
                                <Binding Source="{x:Reference CalendarCollection}" Path="BindingContext.SelectedDay" />
                            </MultiBinding>
                        </Border.Background>

                        <Grid RowDefinitions="*,2*"
                              RowSpacing="0"
                              ColumnSpacing="0"
                              Padding="0"
                              HorizontalOptions="FillAndExpand"
                              VerticalOptions="FillAndExpand">

                            <Label Grid.Row="0"
                                   Text="{Binding DayNumber}"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   Margin="2,2,0,0"
                                   TextColor="{Binding IsCurrentMonth, Converter={StaticResource BoolToColorConverter}}" />

                            <!-- Planet markers (shown between day number and panchanga bars) -->
                            <Label Grid.Row="0"
                                   Text="{Binding PlanetMarkersText}"
                                   FontSize="10"
                                   HorizontalOptions="FillAndExpand"
                                   HorizontalTextAlignment="Start"
                                   VerticalOptions="End"
                                   Margin="2,0,2,2"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1"
                                   TextColor="{Binding IsCurrentMonth, Converter={StaticResource BoolToColorConverter}}" />


                            <Grid Grid.Row="1"
                                  RowDefinitions="*,*,*,*,*,*"
                                  VerticalOptions="FillAndExpand"
                                  HorizontalOptions="FillAndExpand"
                                  RowSpacing="1"
                                  Padding="0,2,0,2">

                                <ui:PanchangaBar Grid.Row="0"
                                    InputTransparent="True"
                                    DayDate="{Binding Date}"
                                    Segments="{Binding NakshatraSegments}" />

                                <ui:PanchangaBar Grid.Row="1"
                                    InputTransparent="True"
                                    DayDate="{Binding Date}"
                                    Segments="{Binding TaraBalaSegments}" />

                                <ui:PanchangaBar Grid.Row="2"
                                    InputTransparent="True"
                                    DayDate="{Binding Date}"
                                    Segments="{Binding TithiSegments}" />

                                <ui:PanchangaBar Grid.Row="3"
                                    InputTransparent="True"
                                    DayDate="{Binding Date}"
                                    Segments="{Binding KaranaSegments}" />

                                <ui:PanchangaBar Grid.Row="4"
                                    InputTransparent="True"   
                                    DayDate="{Binding Date}"
                                    Segments="{Binding NityaYogaSegments}" />

                                <ui:PanchangaBar Grid.Row="5"
                                    InputTransparent="True"
                                    DayDate="{Binding Date}"
                                    Segments="{Binding ChandraBalaSegments}" />
                               
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Busy overlay: appears during calculations and blocks the UI -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="3"
            IsVisible="{Binding IsBusy}"
            InputTransparent="False"
            BackgroundColor="#80000000"
            ZIndex="999">

            <VerticalStackLayout
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="12">

                <ActivityIndicator
                    IsRunning="True"
                    WidthRequest="48"
                    HeightRequest="48" />

                <Label
                    Text="{Binding BusyText}"
                    TextColor="White"
                    FontSize="Medium"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
