<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:PADMA.UI;assembly=PADMA"
             x:Class="PADMA.Pages.MainPage"
             xmlns:controls="clr-namespace:Plugin.Maui.Calendar.Controls;assembly=Plugin.Maui.Calendar"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">

    <Shell.TitleView>
        <Grid Padding="0" VerticalOptions="Center">
            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                <Label Text="{Binding MonthYearTitle}"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />
                <Label Text="▼" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMonthTitleTapped" />
            </Grid.GestureRecognizers>
        </Grid>
    </Shell.TitleView>

    <Grid Padding="0" RowSpacing="0" ColumnSpacing="0">

        <Grid.RowDefinitions>
            <!-- Новый ряд для заголовков дней недели -->
            <RowDefinition Height="Auto" />
            <!-- Основной календарь -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Шапка с аббревиатурами дней -->
        <Grid x:Name="DaysHeaderGrid"
              Grid.Row="0"
              HeightRequest="24"
              Margin="0"
              ColumnSpacing="0"
              RowSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        </Grid>

        <!-- Календарь -->
        <CollectionView x:Name="CalendarCollection"
                        Grid.Row="1"
                        ItemsSource="{Binding Days}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedDay, Mode=TwoWay}"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand"
                        BackgroundColor="White"
                        SelectionChanged="OnSelectionChanged">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="7"
                                 HorizontalItemSpacing="0"
                                 VerticalItemSpacing="0" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="ui:DayItem">
                    <Border
                        HeightRequest="{Binding Source={x:Reference CalendarCollection},
                                                 Path=Height,
                                                 Converter={StaticResource HeightToCellHeightConverter}}"
                        Stroke="Black"
                        StrokeThickness="0.5"
                        Padding="0"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand"
                        Background="{Binding IsToday, Converter={StaticResource TodayBackgroundConverter}}">

                        <Grid RowDefinitions="*,2*"
                              RowSpacing="0"
                              ColumnSpacing="0"
                              Padding="0"
                              HorizontalOptions="FillAndExpand"
                              VerticalOptions="FillAndExpand">

                            <Label Grid.Row="0"
                                   Text="{Binding DayNumber}"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   Margin="2,2,0,0"
                                   TextColor="{Binding IsCurrentMonth, Converter={StaticResource BoolToColorConverter}}" />

                            <Grid Grid.Row="1"
                                  RowDefinitions="*,*,*,*,*,*"
                                  VerticalOptions="FillAndExpand"
                                  HorizontalOptions="FillAndExpand"
                                  RowSpacing="1"
                                  Padding="0,2,0,2">

                                <ui:PanchangaBar Grid.Row="0"
                                    DayDate="{Binding Date}"
                                    Segments="{Binding NakshatraSegments}" />

                                <ui:PanchangaBar Grid.Row="1"
                                    DayDate="{Binding Date}"
                                    Segments="{Binding TaraBalaSegments}" />

                                <ui:PanchangaBar Grid.Row="2"
                                    DayDate="{Binding Date}"
                                    Segments="{Binding TithiSegments}" />

                                <ui:PanchangaBar Grid.Row="3"
                                    DayDate="{Binding Date}"
                                    Segments="{Binding KaranaSegments}" />

                                <ui:PanchangaBar Grid.Row="4"
                                    DayDate="{Binding Date}"
                                    Segments="{Binding NityaYogaSegments}" />

                                <ui:PanchangaBar Grid.Row="5"
                                    DayDate="{Binding Date}"
                                    Segments="{Binding ChandraBalaSegments}" />


                                <!--<BoxView Grid.Row="0" BackgroundColor="Red" />
                                <BoxView Grid.Row="1" BackgroundColor="Orange" />
                                <BoxView Grid.Row="2" BackgroundColor="Yellow" />
                                <BoxView Grid.Row="3" BackgroundColor="Green" />
                                <BoxView Grid.Row="4" BackgroundColor="Blue" />
                                <BoxView Grid.Row="5" BackgroundColor="Purple" />-->
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
