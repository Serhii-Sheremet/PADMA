<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:PADMA.UI.Models"
             x:Class="PADMA.Pages.MainPage"
             Title="Calendar">

    <!-- Один ряд, одна колонка, чтобы календарь занимал весь экран -->
    <Grid RowDefinitions="*" ColumnDefinitions="*">
        <CollectionView x:Name="CalendarCollection"
                        Grid.Row="0"
                        Grid.Column="0"
                        ItemsSource="{Binding Days}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedDay, Mode=TwoWay}"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand"
                        BackgroundColor="White">

            <!-- Макет сетки 7 колонок -->
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="7"
                                 HorizontalItemSpacing="0"
                                 VerticalItemSpacing="0"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DayItem">
                    <Border Stroke="Black"
                            StrokeThickness="0.5"
                            Padding="0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                        <Border Background="{Binding IsToday, Converter={StaticResource TodayBackgroundConverter}}">
                            <Grid RowDefinitions="Auto,*"
                                  RowSpacing="0"
                                  ColumnSpacing="0"
                                  Padding="0"
                                  HorizontalOptions="FillAndExpand"
                                  VerticalOptions="FillAndExpand">

                                <!-- Число дня -->
                                <Label Text="{Binding DayNumber}"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Start"
                                       VerticalOptions="Start"
                                       Margin="2,2,0,0"
                                       TextColor="{Binding IsCurrentMonth, Converter={StaticResource BoolToColorConverter}}" />

                                <!-- Цветные полоски -->
                                <Grid Grid.Row="1"
                                      RowDefinitions="*,*,*,*,*,*"
                                      RowSpacing="1"
                                      Padding="0,2,0,2"
                                      HorizontalOptions="FillAndExpand"
                                      VerticalOptions="FillAndExpand">
                                    <BoxView Grid.Row="0" BackgroundColor="Red"/>
                                    <BoxView Grid.Row="1" BackgroundColor="Orange"/>
                                    <BoxView Grid.Row="2" BackgroundColor="Yellow"/>
                                    <BoxView Grid.Row="3" BackgroundColor="Green"/>
                                    <BoxView Grid.Row="4" BackgroundColor="Blue"/>
                                    <BoxView Grid.Row="5" BackgroundColor="Purple"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
