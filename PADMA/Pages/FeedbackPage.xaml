<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PADMA.Pages.FeedbackPage"
             Title="Send feedback">

    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="close_icon.png"
                     Priority="0"
                     Order="Primary"
                     Clicked="OnCloseClicked" />
    </ContentPage.ToolbarItems>

    <AbsoluteLayout x:Name="PageOverlayRoot">

        <!-- Main page content -->
        <Grid x:Name="MainLayout"
              AbsoluteLayout.LayoutBounds="0,0,1,1"
              AbsoluteLayout.LayoutFlags="All"
              RowDefinitions="*,Auto">

            <ScrollView Grid.Row="0">

                <ScrollView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPageTapped" />
                </ScrollView.GestureRecognizers>

                <VerticalStackLayout Padding="20" Spacing="14">

                    <Label x:Name="pageDescLabel"
                           FontSize="16"
                           HorizontalTextAlignment="Start" />

                    <!-- Category -->
                    <Border Stroke="#BDBDBD"
                            StrokeThickness="1"
                            Padding="10">
                        <VerticalStackLayout Spacing="8">

                            <Label x:Name="categoryLabel"
                                   FontAttributes="Bold" />

                            <HorizontalStackLayout x:Name="CategoryHeader"
                                                   Spacing="4">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCategoryTapped" />
                                </HorizontalStackLayout.GestureRecognizers>

                                <VerticalStackLayout Spacing="2"
                                                     HorizontalOptions="StartAndExpand">
                                    <HorizontalStackLayout Spacing="4">
                                        <Label x:Name="CategoryValueLabel"
                                               VerticalOptions="Center" />

                                        <Label x:Name="CategoryArrow"
                                               Text="▼"
                                               FontSize="14"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <BoxView x:Name="CategoryUnderline"
                                             HeightRequest="2"
                                             WidthRequest="40"
                                             Color="#C8A23A"
                                             HorizontalOptions="Start" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>

                        </VerticalStackLayout>
                    </Border>

                    <!-- Message -->
                    <Border Stroke="#BDBDBD"
                            StrokeThickness="1"
                            Padding="10">
                        <VerticalStackLayout Spacing="8">
                            <Label x:Name="messageLabel"
                                   FontAttributes="Bold" />

                            <Editor x:Name="messageEditor"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="140"
                                    Placeholder="Write your message here..." />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Email -->
                    <Border Stroke="#BDBDBD"
                            StrokeThickness="1"
                            Padding="10">
                        <VerticalStackLayout Spacing="8">
                            <Label x:Name="emailLabel"
                                   FontAttributes="Bold" />

                            <Entry x:Name="emailEntry"
                                   Keyboard="Email"
                                   Placeholder="Email is optional" />
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Spacing="20"/>

                </VerticalStackLayout>
            </ScrollView>

            <!-- Fixed bottom button -->
            <Border Grid.Row="1"
                    Padding="20"
                    StrokeThickness="0">
                <Button x:Name="sendButton"
                        HeightRequest="44"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        CornerRadius="10"
                        Clicked="OnSendClicked" />
            </Border>

        </Grid>

        <!-- Category dropdown panel MUST be here, outside ScrollView/form -->
        <Border x:Name="CategoryPanel"
                IsVisible="False"
                AbsoluteLayout.LayoutBounds="0,0,170,-1"
                AbsoluteLayout.LayoutFlags="None"
                Stroke="#D0D0D0"
                StrokeThickness="1"
                Padding="6,4"
                BackgroundColor="White"
                ZIndex="50">

            <VerticalStackLayout Spacing="8">

                <Label x:Name="CategoryBugLabel">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCategoryBugTapped" />
                    </Label.GestureRecognizers>
                </Label>

                <Label x:Name="CategorySuggestionLabel">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCategorySuggestionTapped" />
                    </Label.GestureRecognizers>
                </Label>

                <Label x:Name="CategoryQuestionLabel">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCategoryQuestionTapped" />
                    </Label.GestureRecognizers>
                </Label>

                <Label x:Name="CategoryOtherLabel">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCategoryOtherTapped" />
                    </Label.GestureRecognizers>
                </Label>

            </VerticalStackLayout>
        </Border>

    </AbsoluteLayout>
</ContentPage>