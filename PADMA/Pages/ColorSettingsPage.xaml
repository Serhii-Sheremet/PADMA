<?xml version="1.0" encoding="utf-8" ?>
<ui:ConfigBasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ui="clr-namespace:PADMA.UI.Templates;assembly=PADMA"
    xmlns:inputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:popup="clr-namespace:Syncfusion.Maui.Popup;assembly=Syncfusion.Maui.Popup"
    x:Class="PADMA.Pages.ColorSettingsPage"
    IsCompact="True"
    ShowTitle="True">

    <AbsoluteLayout>

        <Grid AbsoluteLayout.LayoutBounds="0,0,1,1"
              AbsoluteLayout.LayoutFlags="All"
              Padding="12"
              RowSpacing="10"
              RowDefinitions="*,Auto">

            <!-- Full-width list -->
            <Frame Grid.Row="0" Padding="8">
                <CollectionView x:Name="ColorsList"
                            SelectionMode="Single"
                            SelectionChanged="OnSelectionChanged">

                    <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="#22000000"
                                StrokeThickness="1"
                                BackgroundColor="Transparent"
                                Margin="4,2"
                                Padding="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>

                            <Grid Padding="10"
                                  ColumnSpacing="12"
                                  ColumnDefinitions="90,*,Auto">

                                <!-- color swatch -->
                                <Border BackgroundColor="{Binding MauiColor}"
                                        WidthRequest="80"
                                        HeightRequest="26"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="6"/>
                                    </Border.StrokeShape>
                                </Border>

                                <!-- name -->
                                <Label Grid.Column="1"
                                       Text="{Binding Name}"
                                       LineBreakMode="TailTruncation"
                                       VerticalOptions="Center"
                                       FontSize="16"/>

                                <!-- dirty marker -->
                                <Label Grid.Column="2"
                                       Text="*"
                                       IsVisible="{Binding IsDirty}"
                                       VerticalOptions="Center"/>

                            </Grid>

                            <!-- Selected highlight -->
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#1F000000" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                </CollectionView>
            </Frame>

            <!-- Bottom buttons: left System, right Change -->
            <Grid Grid.Row="1" ColumnSpacing="10"
                  ColumnDefinitions="*,*">
                <Button x:Name="ApplySystemButton"
                        Grid.Column="0"
                        Clicked="OnApplySystemClicked"/>
                <Button x:Name="ChangeButton"
                        Grid.Column="1"
                        Clicked="OnChangeClicked"
                        IsEnabled="False"/>
            </Grid>

            <!--  Busy overlay -->
            <Grid Grid.Row="0"
                  Grid.ColumnSpan="2"
                  IsVisible="{Binding IsBusy, FallbackValue=False}"
                  InputTransparent="False"
                  BackgroundColor="#80000000"
                  ZIndex="999">

                <VerticalStackLayout
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="12">

                    <ActivityIndicator
                        IsRunning="True"
                        WidthRequest="48"
                        HeightRequest="48" />

                    <Label Text="{Binding BusyText}"
                           TextColor="White"
                           FontSize="Medium"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>

        </Grid>

        <popup:SfPopup x:Name="ColorPopup"
               IsOpen="False"
               ShowCloseButton="True"
               ShowHeader="False"
               StaysOpen="False"
               WidthRequest="360"
               HeightRequest="560"
               IsFullScreen="False">

            <popup:SfPopup.ContentTemplate>
                <DataTemplate>
                    <Grid Padding="12"
                          RowDefinitions="Auto,*,56"
                          RowSpacing="10"
                          WidthRequest="360"
                          HeightRequest="540">

                        <Label x:Name="LabelColor"
                               Text="{Binding LabelColor}"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>

                        <inputs:SfColorPicker Grid.Row="1"
                                    Margin="0,0,0,-24"
                                    IsInline="True"
                                    ColorMode="Spectrum"
                                    IsColorModeSwitcherVisible="True"
                                    IsActionButtonsVisible="False"
                                    ShowInputArea="True"
                                    ShowAlphaSlider="True"
                                    Loaded="OnInlinePickerLoaded"
                                    ColorChanged="OnInlineColorChanged"/>

                        <!-- bottom bar (fixed height) -->
                        <Grid Grid.Row="2"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="10"
                              VerticalOptions="End">

                            <Button x:Name="ButtonSelect"
                                    Text="{Binding ButtonSelect}"
                                    HeightRequest="34"
                                    WidthRequest="120"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End"
                                    Clicked="OnSelectColorClicked"/>
                        </Grid>

                    </Grid>
                </DataTemplate>
            </popup:SfPopup.ContentTemplate>

        </popup:SfPopup>

    </AbsoluteLayout>
</ui:ConfigBasePage>