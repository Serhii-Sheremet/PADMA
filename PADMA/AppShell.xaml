<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PADMA.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PADMA"
    Shell.FlyoutBehavior="Flyout"
    Title="PADMA">


    <FlyoutItem Title="Home">
        <Tab>
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
        </Tab>
    </FlyoutItem>

    <FlyoutItem Title="Configurations">
        <Tab>
            <ShellContent ContentTemplate="{DataTemplate local:ConfigPage}" />
        </Tab>
    </FlyoutItem>

    <FlyoutItem Title="Exit">
        <Tab>
            <ShellContent ContentTemplate="{DataTemplate local:ExitPage}" />
        </Tab>
    </FlyoutItem>



</Shell>
