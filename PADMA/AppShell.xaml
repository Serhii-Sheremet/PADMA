<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:PADMA.Pages"
       x:Class="PADMA.AppShell">

    <!-- Календарь -->
    <ShellItem Route="calendar">
        <ShellContent
            Title="Calendar"
            ContentTemplate="{DataTemplate pages:MainPage}" />
    </ShellItem>

    <!-- Страница дня -->
    <ShellContent
        Title="Day"
        Route="day"
        ContentTemplate="{DataTemplate pages:DayPage}" />

    <!-- Настройки -->
    <FlyoutItem Title="Settings">
        <ShellContent ContentTemplate="{DataTemplate pages:ConfigurationPage}" />
    </FlyoutItem>

    <!-- Exit -->
    <FlyoutItem Title="Exit">
        <ShellContent ContentTemplate="{DataTemplate pages:ExitPage}" />
    </FlyoutItem>
</Shell>
