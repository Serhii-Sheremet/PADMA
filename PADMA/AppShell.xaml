<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:PADMA.Pages"
    x:Class="PADMA.AppShell"
    x:Name="RootShell">

    <Shell.FlyoutHeader>
        <Grid
            BackgroundColor="#C94D7F"
            Padding="10,10,10,10"
            ColumnDefinitions="82,*"
            ColumnSpacing="10"
            MinimumHeightRequest="104">

            <Image
                Grid.Column="0"
                Source="flyout_logo.png"
                HeightRequest="64"
                WidthRequest="64"
                Aspect="AspectFit"
                VerticalOptions="Center"
                HorizontalOptions="Center" />

            <VerticalStackLayout
                Grid.Column="1"
                VerticalOptions="Center"
                Spacing="2">

                <Label
                    Text="{Binding FlyoutAppTitle}"
                    FontFamily="HarringtonNormal"
                    FontSize="20"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    TextColor="#FFD700"
                    LineBreakMode="WordWrap" />

                <Label
                    Text="{Binding FlyoutAppSubtitle}"
                    FontFamily="HarringtonNormal"
                    FontSize="14"
                    HorizontalTextAlignment="Center"
                    TextColor="#FFD700"
                    Opacity="0.85"
                    LineBreakMode="NoWrap" />

            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <Shell.FlyoutFooter>
        <Grid Padding="16,10,16,16">
            <Label
                Text="{Binding FlyoutVersionText}"
                FontSize="12"
                TextColor="Gray"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Grid>
    </Shell.FlyoutFooter>

    <FlyoutItem Title="{Binding FlyoutCalendarTitle}" Route="main">
        <ShellContent ContentTemplate="{DataTemplate pages:MainPage}" />
    </FlyoutItem>

    <FlyoutItem Title="{Binding FlyoutProfilesTitle}" Route="profiles">
        <ShellContent ContentTemplate="{DataTemplate pages:ProfilesPage}" />
    </FlyoutItem>

    <FlyoutItem Title="{Binding FlyoutTransitChartsTitle}" Route="transitCharts">
        <ShellContent ContentTemplate="{DataTemplate pages:TransitChartsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="{Binding FlyoutSettingsTitle}" Route="settings">
        <ShellContent ContentTemplate="{DataTemplate pages:ConfigurationPage}" />
    </FlyoutItem>

    <FlyoutItem Title="{Binding FlyoutAboutTitle}" Route="about">
        <ShellContent ContentTemplate="{DataTemplate pages:AboutPage}" />
    </FlyoutItem>

    <FlyoutItem Title="{Binding FlyoutFAQTitle}" Route="faq">
        <ShellContent ContentTemplate="{DataTemplate pages:FaqPage}" />
    </FlyoutItem>

    <MenuItem Text="{Binding FlyoutExitTitle}"
              Clicked="OnExitMenuItemClicked" />

    <ShellContent Route="dayOverview" ContentTemplate="{DataTemplate pages:DayOverviewPage}" />
    <ShellContent Route="day" ContentTemplate="{DataTemplate pages:DayPage}" />
    <ShellContent Route="firstDayOfWeek" ContentTemplate="{DataTemplate pages:FirstDayOfWeekPage}" />

</Shell>