<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:PADMA.Pages"
       x:Class="PADMA.AppShell">

    <!-- Главная: календарь в бургер-меню, маршрут //calendar -->
    <FlyoutItem Title="Calendar" Route="calendar">
        <ShellContent Title="Calendar">
            <pages:MainPage />
        </ShellContent>
    </FlyoutItem>

    <!-- Страница дня: отдельный маршрут (в меню не показываем) -->
    <ShellContent Route="day">
        <pages:DayPage />
    </ShellContent>

    <!-- Настройки -->
    <FlyoutItem Title="Настройки" Route="ConfigurationPageRoute">
        <ShellContent>
            <pages:ConfigurationPage />
        </ShellContent>
    </FlyoutItem>

    <!-- Exit -->
    <FlyoutItem Title="Exit" Route="ExitPageRoute">
        <ShellContent>
            <pages:ExitPage />
        </ShellContent>
    </FlyoutItem>
</Shell>
