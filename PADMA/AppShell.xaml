<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:PADMA.Pages"
       x:Class="PADMA.AppShell">

    <!-- Главный пункт с календарём -->
    <FlyoutItem Title="Calendar" Route="calendar">
        <ShellContent
            Title="Calendar"
            Route="calendar"
            ContentTemplate="{DataTemplate pages:MainPage}" />
    </FlyoutItem>

    <!-- Страница дня (скрыта из меню, вызывается только через GoToAsync) -->
    <ShellContent
        Route="day"
        Title="Day"
        FlyoutItemIsVisible="False"
        ContentTemplate="{DataTemplate pages:DayPage}" />

    <!-- Страница конфигурации -->
    <FlyoutItem Title="Настройки" Route="ConfigurationPageRoute">
        <ShellContent ContentTemplate="{DataTemplate pages:ConfigurationPage}" />
    </FlyoutItem>

    <!-- Exit -->
    <FlyoutItem Title="Exit" Route="ExitPageRoute">
        <ShellContent ContentTemplate="{DataTemplate pages:ExitPage}" />
    </FlyoutItem>
</Shell>
