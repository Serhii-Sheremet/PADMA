<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Обновлённые целевые фреймворки -->
	<TargetFrameworks>net9.0-android36.0;net9.0-ios;net9.0-maccatalyst;net9.0-windows10.0.19041.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>PADMA</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- App info -->
    <ApplicationTitle>Personal Astrological Diary</ApplicationTitle>
    <ApplicationId>com.ssheremet.padma</ApplicationId>
    <ApplicationDisplayVersion>0.7.8</ApplicationDisplayVersion>
    <ApplicationVersion>20</ApplicationVersion>

    <!-- Windows -->
    <WindowsPackageType>None</WindowsPackageType>

    <!-- Поддерживаемые платформы -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

    <!-- Убираем предупреждение о старых workload’ах -->
    <NoWarn>$(NoWarn);NETSDK1202</NoWarn>
	<SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
  </PropertyGroup>
	
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidPackageFormat>aab</AndroidPackageFormat>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(TargetFramework)'=='net9.0-android' AND '$(Configuration)'=='Debug'">
    <RuntimeIdentifier>android-x64</RuntimeIdentifier>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(TargetFramework)'=='net9.0-android' AND '$(Configuration)'=='Release'">
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#FFFFFF" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#CA3D80" BaseSize="500,500" />
    <MauiImage Include="Resources\Images\*.png" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Packages -->  
    <PackageReference Include="CommunityToolkit.Maui" Version="12.1.0" />   
    <PackageReference Include="Plugin.Maui.Calendar" Version="2.0.12" />
	<PackageReference Include="Plugin.LocalNotification" Version="10.1.8" />
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
	<PackageReference Include="NodaTime" Version="3.2.2" />
	<PackageReference Include="GeoTimeZone" Version="6.1.0" />
	<PackageReference Include="Syncfusion.Maui.Inputs" Version="33.1.45" />
	<PackageReference Include="TimeZoneConverter" Version="7.2.0" />

    <!-- Logging -->
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />    
  </ItemGroup>
  
  <ItemGroup>
	<!-- Shared assets -->
	<MauiAsset Include="Resources\Raw\PADMADB.db3" LogicalName="PADMADB.db3" />
	<MauiAsset Include="Resources\Raw\faq_*.html" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <!-- Android-only ephemeris archive -->
    <MauiAsset Include="Resources\Raw\ephe.zip" LogicalName="ephe.zip" />
  
    <!-- Android native Swiss Ephemeris & sqlite libraries -->
    <AndroidNativeLibrary Include="Platforms\Android\libs\**\*.so" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <!-- Windows native Swiss Ephemeris DLL -->
    <Content Include="Platforms\Windows\swedll64.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  
    <!-- Windows ephemeris files -->
    <Content Include="Platforms\Windows\ephe\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Resources\Raw\ephe\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <!-- XAML Dependencies -->
  <ItemGroup>
    <Compile Update="Pages\AboutPage.xaml.cs">
      <DependentUpon>AboutPage.xaml</DependentUpon>
    </Compile>
    <Compile Update="Pages\ColorSettingsPage.xaml.cs">
      <DependentUpon>ColorSettingsPage.xaml</DependentUpon>
    </Compile>
    <Compile Update="Pages\ConfigurationPage.xaml.cs">
      <DependentUpon>ConfigurationPage.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <MauiXaml Update="Pages\AboutPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Pages\BirthChartPreviewPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Pages\ColorLookupPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Pages\ColorSettingsPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Pages\ConfigurationPage.xaml" Generator="MSBuild:Compile" />
    <MauiXaml Update="Pages\CountrySelectPopup.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Pages\DayPage.xaml" Generator="MSBuild:Compile" />
    <MauiXaml Update="Pages\FaqPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Pages\FeedbackPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Pages\FirstDayOfWeekPage.xaml" Generator="MSBuild:Compile" />
    <MauiXaml Update="Pages\HoraPage.xaml" Generator="MSBuild:Compile" />
    <MauiXaml Update="Pages\LanguagePage.xaml" Generator="MSBuild:Compile" />
    <MauiXaml Update="Pages\LocationSearchPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Pages\MrityuPage.xaml" Generator="MSBuild:Compile" />
	<MauiXaml Update="Pages\MonthlyPlanetTransitsPage.xaml" Generator="MSBuild:Compile" />
    <MauiXaml Update="Pages\MuhurtasPage.xaml" Generator="MSBuild:Compile" />
    <MauiXaml Update="Pages\NodesPage.xaml" Generator="MSBuild:Compile" />
    <MauiXaml Update="Pages\NotificationsPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Pages\PaymentPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Pages\ProfileDetailPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Pages\RetentionPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Pages\SunrisePage.xaml" Generator="MSBuild:Compile" />
    <MauiXaml Update="Pages\TransitChartsPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Pages\TransitsPage.xaml" Generator="MSBuild:Compile" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Core\Native\" />
    <Folder Include="UI\Charts\" />
  </ItemGroup>

</Project>
